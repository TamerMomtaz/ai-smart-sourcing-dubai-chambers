    "path": "services/trend_analysis_service.py",
    "content": "from typing import Optional, List, Dict, Any\nfrom uuid import UUID\nfrom datetime import date, datetime, timezone\nimport json\nfrom database import supabase\n\n\ndef create(\n    analysis_date: date,\n    sector: Optional[str],\n    technology_trends_json: Optional[Dict[str, Any]],\n    submission_volume: int,\n    average_scores: Optional[Dict[str, Any]],\n    emerging_technologies: Optional[List[str]],\n    generated_by: str,\n) -> Optional[Dict[str, Any]]:\n    \"\"\"Create new trend analysis.\"\"\"\n    try:\n        payload = {\n            \"analysis_date\": analysis_date.isoformat(),\n            \"sector\": sector,\n            \"technology_trends_json\": json.dumps(technology_trends_json) if technology_trends_json else None,\n            \"submission_volume\": submission_volume,\n            \"average_scores\": json.dumps(average_scores) if average_scores else None,\n            \"emerging_technologies\": json.dumps(emerging_technologies) if emerging_technologies else None,\n            \"generated_by\": generated_by,\n        }\n\n        response = (\n            supabase.table(\"chamber_trend_analyses\")\n            .insert(payload)\n            .execute()\n        )\n\n        if response.data and len(response.data) > 0:\n            record = response.data[0]\n            # Deserialize JSON fields\n            if record.get(\"technology_trends_json\"):\n                record[\"technology_trends_json\"] = json.loads(record[\"technology_trends_json\"])\n            if record.get(\"average_scores\"):\n                record[\"average_scores\"] = json.loads(record[\"average_scores\"])\n            if record.get(\"emerging_technologies\"):\n                record[\"emerging_technologies\"] = json.loads(record[\"emerging_technologies\"])\n            return record\n        return None\n    except Exception as e:\n        print(f\"Error creating trend analysis: {str(e)}\")\n        return None\n\n\ndef list_analyses(\n    page: int = 1,\n    page_size: int = 20,\n    sector: Optional[str] = None,\n    start_date: Optional[date] = None,\n    end_date: Optional[date] = None,\n) -> tuple[List[Dict[str, Any]], int]:\n    \"\"\"List trend analyses with pagination and optional filters.\"\"\"\n    try:\n        query = supabase.table(\"chamber_trend_analyses\").select(\"*\", count=\"exact\")\n\n        # Apply filters\n        if sector:\n            query = query.eq(\"sector\", sector)\n        if start_date:\n            query = query.gte(\"analysis_date\", start_date.isoformat())\n        if end_date:\n            query = query.lte(\"analysis_date\", end_date.isoformat())\n\n        # Order by analysis_date descending\n        query = query.order(\"analysis_date\", desc=True)\n\n        # Apply pagination\n        offset = (page - 1) * page_size\n        query = query.range(offset, offset + page_size - 1)\n\n        response = query.execute()\n\n        records = response.data or []\n        total = response.count or 0\n\n        # Deserialize JSON fields\n        for record in records:\n            if record.get(\"technology_trends_json\"):\n                record[\"technology_trends_json\"] = json.loads(record[\"technology_trends_json\"])\n            if record.get(\"average_scores\"):\n                record[\"average_scores\"] = json.loads(record[\"average_scores\"])\n            if record.get(\"emerging_technologies\"):\n                record[\"emerging_technologies\"] = json.loads(record[\"emerging_technologies\"])\n\n        return records, total\n    except Exception as e:\n        print(f\"Error listing trend analyses: {str(e)}\")\n        return [], 0\n\n\ndef get_by_id(analysis_id: UUID) -> Optional[Dict[str, Any]]:\n    \"\"\"Get trend analysis by ID.\"\"\"\n    try:\n        response = (\n            supabase.table(\"chamber_trend_analyses\")\n            .select(\"*\")\n            .eq(\"id\", str(analysis_id))\n            .execute()\n        )\n\n        if response.data and len(response.data) > 0:\n            record = response.data[0]\n            # Deserialize JSON fields\n            if record.get(\"technology_trends_json\"):\n                record[\"technology_trends_json\"] = json.loads(record[\"technology_trends_json\"])\n            if record.get(\"average_scores\"):\n                record[\"average_scores\"] = json.loads(record[\"average_scores\"])\n            if record.get(\"emerging_technologies\"):\n                record[\"emerging_technologies\"] = json.loads(record[\"emerging_technologies\"])\n            return record\n        return None\n    except Exception as e:\n        print(f\"Error getting trend analysis by ID: {str(e)}\")\n        return None\n\n\ndef update(\n    analysis_id: UUID,\n    technology_trends_json: Optional[Dict[str, Any]] = None,\n    average_scores: Optional[Dict[str, Any]] = None,\n    emerging_technologies: Optional[List[str]] = None,\n    submission_volume: Optional[int] = None,\n) -> Optional[Dict[str, Any]]:\n    \"\"\"Update trend analysis.\"\"\"\n    try:\n        payload = {\"updated_at\": datetime.now(timezone.utc).isoformat()}\n\n        if technology_trends_json is not None:\n            payload[\"technology_trends_json\"] = json.dumps(technology_trends_json)\n        if average_scores is not None:\n            payload[\"average_scores\"] = json.dumps(average_scores)\n        if emerging_technologies is not None:\n            payload[\"emerging_technologies\"] = json.dumps(emerging_technologies)\n        if submission_volume is not None:\n            payload[\"submission_volume\"] = submission_volume\n\n        response = (\n            supabase.table(\"chamber_trend_analyses\")\n            .update(payload)\n            .eq(\"id\", str(analysis_id))\n            .execute()\n        )\n\n        if response.data and len(response.data) > 0:\n            record = response.data[0]\n            # Deserialize JSON fields\n            if record.get(\"technology_trends_json\"):\n                record[\"technology_trends_json\"] = json.loads(record[\"technology_trends_json\"])\n            if record.get(\"average_scores\"):\n                record[\"average_scores\"] = json.loads(record[\"average_scores\"])\n            if record.get(\"emerging_technologies\"):\n                record[\"emerging_technologies\"] = json.loads(record[\"emerging_technologies\"])\n            return record\n        return None\n    except Exception as e:\n        print(f\"Error updating trend analysis: {str(e)}\")\n        return None\n\n\ndef delete(analysis_id: UUID) -> bool:\n    \"\"\"Delete (hard delete) trend analysis by ID.\"\"\"\n    try:\n        response = (\n            supabase.table(\"chamber_trend_analyses\")\n            .delete()\n            .eq(\"id\", str(analysis_id))\n            .execute()\n        )\n\n        return response.data is not None and len(response.data) > 0\n    except Exception as e:\n        print(f\"Error deleting trend analysis: {str(e)}\")\n        return False\n\n\ndef get_latest_by_sector(sector: Optional[str] = None) -> Optional[Dict[str, Any]]:\n    \"\"\"Get the most recent trend analysis for a sector (or cross-sector if None).\"\"\"\n    try:\n        query = supabase.table(\"chamber_trend_analyses\").select(\"*\")\n\n        if sector:\n            query = query.eq(\"sector\", sector)\n        else:\n            query = query.is_(\"sector\", \"null\")\n\n        query = query.order(\"analysis_date\", desc=True).limit(1)\n\n        response = query.execute()\n\n        if response.data and len(response.data) > 0:\n            record = response.data[0]\n            # Deserialize JSON fields\n            if record.get(\"technology_trends_json\"):\n                record[\"technology_trends_json\"] = json.loads(record[\"technology_trends_json\"])\n            if record.get(\"average_scores\"):\n                record[\"average_scores\"] = json.loads(record[\"average_scores\"])\n            if record.get(\"emerging_technologies\"):\n                record[\"emerging_technologies\"] = json.loads(record[\"emerging_technologies\"])\n            return record\n        return None\n    except Exception as e:\n        print(f\"Error getting latest trend analysis by sector: {str(e)}\")\n        return None\n\n\ndef get_by_date_range(\n    start_date: date,\n    end_date: date,\n    sector: Optional[str] = None,\n) -> List[Dict[str, Any]]:\n    \"\"\"Get trend analyses within a date range, optionally filtered by sector.\"\"\"\n    try:\n        query = (\n            supabase.table(\"chamber_trend_analyses\")\n            .select(\"*\")\n            .gte(\"analysis_date\", start_date.isoformat())\n            .lte(\"analysis_date\", end_date.isoformat())\n        )\n\n        if sector:\n            query = query.eq(\"sector\", sector)\n\n        query = query.order(\"analysis_date\", desc=True)\n\n        response = query.execute()\n\n        records = response.data or []\n\n        # Deserialize JSON fields\n        for record in records:\n            if record.get(\"technology_trends_json\"):\n                record[\"technology_trends_json\"] = json.loads(record[\"technology_trends_json\"])\n            if record.get(\"average_scores\"):\n                record[\"average_scores\"] = json.loads(record[\"average_scores\"])\n            if record.get(\"emerging_technologies\"):\n                record[\"emerging_technologies\"] = json.loads(record[\"emerging_technologies\"])\n\n        return records\n    except Exception as e:\n        print(f\"Error getting trend analyses by date range: {str(e)}\")\n        return []\n"
