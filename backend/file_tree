    "path": "services/ai_interaction_service.py",
    "content": "from typing import Optional, Dict, Any, List\nfrom uuid import UUID\nfrom datetime import datetime, timezone\nfrom database import supabase\n\n\ndef get_ai_interaction_summary(user_id: UUID, limit: int = 10) -> Optional[Dict[str, Any]]:\n    \"\"\"\n    Get \u03a3I (sigma intelligence) tracking data for AI model usage.\n    Aggregates total interactions, tokens, costs, energy, carbon, and intelligence units.\n    Returns model breakdown and recent interactions.\n    \"\"\"\n    try:\n        # Get total aggregated metrics\n        total_response = supabase.rpc(\n            \"get_ai_interaction_totals\",\n            {\"p_user_id\": str(user_id)}\n        ).execute()\n\n        if not total_response.data or len(total_response.data) == 0:\n            return {\n                \"total_interactions\": 0,\n                \"total_tokens\": 0,\n                \"total_cost_usd\": 0.0,\n                \"total_energy_kwh\": 0.0,\n                \"total_carbon_gco2\": 0.0,\n                \"total_intelligence_units\": 0.0,\n                \"model_breakdown\": [],\n                \"recent_interactions\": []\n            }\n\n        totals = total_response.data[0]\n\n        # Get model breakdown\n        model_breakdown_response = supabase.rpc(\n            \"get_ai_interaction_model_breakdown\",\n            {\"p_user_id\": str(user_id)}\n        ).execute()\n\n        model_breakdown = []\n        if model_breakdown_response.data:\n            for row in model_breakdown_response.data:\n                model_breakdown.append({\n                    \"model_name\": row.get(\"model_name\", \"\"),\n                    \"interaction_count\": row.get(\"interaction_count\", 0),\n                    \"total_tokens\": row.get(\"total_tokens\", 0),\n                    \"total_cost_usd\": float(row.get(\"total_cost_usd\", 0.0)),\n                    \"average_latency_ms\": float(row.get(\"average_latency_ms\", 0.0))\n                })\n\n        # Get recent interactions\n        recent_response = supabase.table(\"ai_interactions\") \\\n            .select(\"id, created_at, model_name, operation_type, prompt_tokens, completion_tokens, latency_ms, cost_usd\") \\\n            .eq(\"created_by\", str(user_id)) \\\n            .order(\"created_at\", desc=True) \\\n            .limit(limit) \\\n            .execute()\n\n        recent_interactions = []\n        if recent_response.data:\n            for row in recent_response.data:\n                recent_interactions.append({\n                    \"id\": row[\"id\"],\n                    \"timestamp\": row[\"created_at\"],\n                    \"model_name\": row.get(\"model_name\", \"\"),\n                    \"operation_type\": row.get(\"operation_type\", \"\"),\n                    \"prompt_tokens\": row.get(\"prompt_tokens\", 0),\n                    \"completion_tokens\": row.get(\"completion_tokens\", 0),\n                    \"latency_ms\": row.get(\"latency_ms\", 0),\n                    \"cost_usd\": float(row.get(\"cost_usd\", 0.0))\n                })\n\n        return {\n            \"total_interactions\": totals.get(\"total_interactions\", 0),\n            \"total_tokens\": totals.get(\"total_tokens\", 0),\n            \"total_cost_usd\": float(totals.get(\"total_cost_usd\", 0.0)),\n            \"total_energy_kwh\": float(totals.get(\"total_energy_kwh\", 0.0)),\n            \"total_carbon_gco2\": float(totals.get(\"total_carbon_gco2\", 0.0)),\n            \"total_intelligence_units\": float(totals.get(\"total_intelligence_units\", 0.0)),\n            \"model_breakdown\": model_breakdown,\n            \"recent_interactions\": recent_interactions\n        }\n\n    except Exception as e:\n        print(f\"Error fetching AI interaction summary: {str(e)}\")\n        return None\n\n\ndef log_ai_interaction(\n    user_id: UUID,\n    model_name: str,\n    operation_type: str,\n    prompt_tokens: int,\n    completion_tokens: int,\n    latency_ms: int,\n    cost_usd: float,\n    energy_kwh: Optional[float] = None,\n    carbon_gco2: Optional[float] = None,\n    intelligence_units: Optional[float] = None,\n    metadata: Optional[Dict[str, Any]] = None\n) -> Optional[Dict[str, Any]]:\n    \"\"\"\n    Log a new AI interaction for tracking.\n    Used internally by evaluation and AI services.\n    \"\"\"\n    try:\n        payload = {\n            \"created_by\": str(user_id),\n            \"model_name\": model_name,\n            \"operation_type\": operation_type,\n            \"prompt_tokens\": prompt_tokens,\n            \"completion_tokens\": completion_tokens,\n            \"latency_ms\": latency_ms,\n            \"cost_usd\": cost_usd,\n            \"created_at\": datetime.now(timezone.utc).isoformat()\n        }\n\n        if energy_kwh is not None:\n            payload[\"energy_kwh\"] = energy_kwh\n\n        if carbon_gco2 is not None:\n            payload[\"carbon_gco2\"] = carbon_gco2\n\n        if intelligence_units is not None:\n            payload[\"intelligence_units\"] = intelligence_units\n\n        if metadata is not None:\n            payload[\"metadata\"] = metadata\n\n        response = supabase.table(\"ai_interactions\").insert(payload).execute()\n\n        if response.data and len(response.data) > 0:\n            return response.data[0]\n\n        return None\n\n    except Exception as e:\n        print(f\"Error logging AI interaction: {str(e)}\")\n        return None\n\n\ndef get_ai_interaction_by_id(user_id: UUID, interaction_id: UUID) -> Optional[Dict[str, Any]]:\n    \"\"\"\n    Get a specific AI interaction by ID.\n    Verifies ownership before returning.\n    \"\"\"\n    try:\n        response = supabase.table(\"ai_interactions\") \\\n            .select(\"*\") \\\n            .eq(\"id\", str(interaction_id)) \\\n            .eq(\"created_by\", str(user_id)) \\\n            .execute()\n\n        if response.data and len(response.data) > 0:\n            return response.data[0]\n\n        return None\n\n    except Exception as e:\n        print(f\"Error fetching AI interaction by ID: {str(e)}\")\n        return None\n\n\ndef list_ai_interactions(\n    user_id: UUID,\n    page: int = 1,\n    page_size: int = 20,\n    model_name: Optional[str] = None,\n    operation_type: Optional[str] = None\n) -> Optional[Dict[str, Any]]:\n    \"\"\"\n    List AI interactions with optional filters.\n    Returns paginated results.\n    \"\"\"\n    try:\n        offset = (page - 1) * page_size\n\n        query = supabase.table(\"ai_interactions\") \\\n            .select(\"*\", count=\"exact\") \\\n            .eq(\"created_by\", str(user_id))\n\n        if model_name:\n            query = query.eq(\"model_name\", model_name)\n\n        if operation_type:\n            query = query.eq(\"operation_type\", operation_type)\n\n        query = query.order(\"created_at\", desc=True) \\\n            .range(offset, offset + page_size - 1)\n\n        response = query.execute()\n\n        total = response.count if response.count is not None else 0\n        total_pages = (total + page_size - 1) // page_size if page_size > 0 else 0\n\n        return {\n            \"data\": response.data or [],\n            \"pagination\": {\n                \"total\": total,\n                \"page\": page,\n                \"page_size\": page_size,\n                \"total_pages\": total_pages\n            }\n        }\n\n    except Exception as e:\n        print(f\"Error listing AI interactions: {str(e)}\")\n        return None\n\n\ndef delete_ai_interaction(user_id: UUID, interaction_id: UUID) -> bool:\n    \"\"\"\n    Soft delete an AI interaction (set deleted_at timestamp).\n    Verifies ownership before deletion.\n    \"\"\"\n    try:\n        response = supabase.table(\"ai_interactions\") \\\n            .update({\"deleted_at\": datetime.now(timezone.utc).isoformat()}) \\\n            .eq(\"id\", str(interaction_id)) \\\n            .eq(\"created_by\", str(user_id)) \\\n            .execute()\n\n        return response.data is not None and len(response.data) > 0\n\n    except Exception as e:\n        print(f\"Error deleting AI interaction: {str(e)}\")\n        return False\n"
  },
