    "path": "routes/trend_analysis_routes.py",
    "content": "from fastapi import APIRouter, Depends, HTTPException, status\nfrom typing import Dict, Any\nfrom uuid import UUID\nfrom datetime import datetime, timezone\nimport logging\n\nfrom models import TrendAnalysisGenerateRequest, ErrorResponse\nfrom services.generate_service import trigger_trend_analysis_generation\nfrom dependencies.auth import get_current_user\n\nlogger = logging.getLogger(__name__)\n\nrouter = APIRouter(\n    prefix=\"/api/v1/trend-analyses\",\n    tags=[\"Trend Analysis\"]\n)\n\n\n@router.post(\n    \"/generate\",\n    status_code=status.HTTP_202_ACCEPTED,\n    response_model=Dict[str, Any],\n    responses={\n        401: {\"model\": ErrorResponse, \"description\": \"Unauthorized\"},\n        403: {\"model\": ErrorResponse, \"description\": \"Forbidden - executive role required\"},\n        422: {\"model\": ErrorResponse, \"description\": \"Validation error\"},\n        500: {\"model\": ErrorResponse, \"description\": \"Internal server error\"},\n    },\n)\nasync def generate_trend_analysis(\n    request: TrendAnalysisGenerateRequest,\n    current_user: Dict[str, Any] = Depends(get_current_user),\n):\n    \"\"\"\n    Trigger AI trend analysis generation (executive only).\n    \n    This endpoint queues a background job to generate trend analysis for a given sector\n    and date range. The analysis aggregates proposal data, scores, and emerging technologies.\n    \n    **Role Required:** executive\n    \n    **Rate Limit:** 10 requests per hour\n    \n    Args:\n        request: TrendAnalysisGenerateRequest containing sector and date range\n        current_user: Authenticated user from JWT (injected by dependency)\n    \n    Returns:\n        Dict containing:\n        - job_id: UUID of the background job\n        - status: \"processing\"\n        - estimated_completion: ISO 8601 timestamp\n    \n    Raises:\n        HTTPException 403: If user is not an executive\n        HTTPException 422: If date range is invalid\n        HTTPException 500: If job creation fails\n    \"\"\"\n    try:\n        user_id = UUID(current_user[\"id\"])\n        user_role = current_user[\"role\"]\n        \n        # Enforce executive-only access\n        if user_role != \"executive\":\n            logger.warning(\n                f\"User {user_id} with role '{user_role}' attempted to generate trend analysis\"\n            )\n            raise HTTPException(\n                status_code=status.HTTP_403_FORBIDDEN,\n                detail={\n                    \"error\": \"Forbidden\",\n                    \"detail\": \"Executive role required to generate trend analyses\",\n                    \"code\": \"ROLE_INSUFFICIENT\",\n                },\n            )\n        \n        # Validate date range\n        if request.date_range_start > request.date_range_end:\n            raise HTTPException(\n                status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,\n                detail={\n                    \"error\": \"Validation Error\",\n                    \"detail\": \"date_range_start must be before or equal to date_range_end\",\n                    \"code\": \"INVALID_DATE_RANGE\",\n                },\n            )\n        \n        # Trigger trend analysis job\n        result = await trigger_trend_analysis_generation(\n            user_id=user_id,\n            sector=request.sector,\n            date_range_start=request.date_range_start.isoformat(),\n            date_range_end=request.date_range_end.isoformat(),\n        )\n        \n        if not result:\n            logger.error(f\"Failed to create trend analysis job for user {user_id}\")\n            raise HTTPException(\n                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                detail={\n                    \"error\": \"Job Creation Failed\",\n                    \"detail\": \"Unable to queue trend analysis generation job\",\n                    \"code\": \"JOB_CREATION_ERROR\",\n                },\n            )\n        \n        logger.info(\n            f\"Trend analysis job {result['job_id']} created by user {user_id} \"\n            f\"(sector: {request.sector or 'all'}, range: {request.date_range_start} to {request.date_range_end})\"\n        )\n        \n        return {\n            \"job_id\": result[\"job_id\"],\n            \"status\": result[\"status\"],\n            \"estimated_completion\": result[\"estimated_completion\"],\n        }\n    \n    except HTTPException:\n        raise\n    except ValueError as e:\n        logger.error(f\"Validation error in trend analysis generation: {str(e)}\")\n        raise HTTPException(\n            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,\n            detail={\n                \"error\": \"Validation Error\",\n                \"detail\": str(e),\n                \"code\": \"INVALID_INPUT\",\n            },\n        )\n    except Exception as e:\n        logger.exception(f\"Unexpected error generating trend analysis: {str(e)}\")\n        raise HTTPException(\n            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n            detail={\n                \"error\": \"Internal Server Error\",\n                \"detail\": \"An unexpected error occurred while generating trend analysis\",\n                \"code\": \"INTERNAL_ERROR\",\n            },\n        )\n"
  },
