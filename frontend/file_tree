  {
    "path": "src/styles/globals.css",
    "content": "@tailwind base;\n@tailwind components;\n@tailwind utilities;\n\n@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Cormorant+Garamond:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n\n:root {\n  --color-teal: #016764;\n  --color-gold: #B8904A;\n  --color-burgundy: #7A1E47;\n  --color-cream: #FAF8F4;\n  --color-ink: #1A1612;\n  --font-body: 'Outfit', sans-serif;\n  --font-heading: 'Cormorant Garamond', serif;\n  --font-mono: 'JetBrains Mono', monospace;\n}\n\n@layer base {\n  body {\n    @apply bg-cream text-ink font-body;\n  }\n\n  h1,\n  h2,\n  h3,\n  h4,\n  h5,\n  h6 {\n    @apply font-heading;\n  }\n\n  code,\n  pre {\n    @apply font-mono;\n  }\n}\n\n@layer utilities {\n  .text-teal {\n    color: var(--color-teal);\n  }\n\n  .bg-teal {\n    background-color: var(--color-teal);\n  }\n\n  .border-teal {\n    border-color: var(--color-teal);\n  }\n\n  .text-gold {\n    color: var(--color-gold);\n  }\n\n  .bg-gold {\n    background-color: var(--color-gold);\n  }\n\n  .border-gold {\n    border-color: var(--color-gold);\n  }\n\n  .text-burgundy {\n    color: var(--color-burgundy);\n  }\n\n  .bg-burgundy {\n    background-color: var(--color-burgundy);\n  }\n\n  .border-burgundy {\n    border-color: var(--color-burgundy);\n  }\n\n  .bg-cream {\n    background-color: var(--color-cream);\n  }\n\n  .text-ink {\n    color: var(--color-ink);\n  }\n\n  .font-body {\n    font-family: var(--font-body);\n  }\n\n  .font-heading {\n    font-family: var(--font-heading);\n  }\n\n  .font-mono {\n    font-family: var(--font-mono);\n  }\n}\n"
  },
  {
    "path": "src/pages/Dashboard.jsx",
    "content": "import React, { useState, useEffect } from 'react';\nimport api, { getErrorMessage } from '../lib/api';\n\nfunction Dashboard() {\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState('');\n  const [stats, setStats] = useState(null);\n\n  useEffect(() => {\n    const fetchDashboard = async () => {\n      setLoading(true);\n      setError('');\n      try {\n        const response = await api.get('/api/v1/api/v1/dashboard/analyst');\n        setStats(response.data);\n      } catch (err) {\n        setError(getErrorMessage(err));\n      } finally {\n        setLoading(false);\n      }\n    };\n\n    fetchDashboard();\n  }, []);\n\n  if (loading) {\n    return (\n      <div className=\"flex items-center justify-center py-12\">\n        <div className=\"animate-spin rounded-full h-8 w-8 border-b-2 border-teal\"></div>\n      </div>\n    );\n  }\n\n  if (error) {\n    return (\n      <div className=\"bg-burgundy/10 border border-burgundy/20 rounded-lg p-4\">\n        <p className=\"text-burgundy font-body\">{error}</p>\n      </div>\n    );\n  }\n\n  return (\n    <div>\n      <h1 className=\"font-heading text-3xl text-ink mb-6\">Dashboard</h1>\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n        <div className=\"bg-white rounded-lg shadow-sm p-6\">\n          <p className=\"font-body text-sm text-ink/60 mb-2\">Total Proposals</p>\n          <p className=\"font-heading text-3xl text-teal\">{stats?.total_proposals || 0}</p>\n        </div>\n        <div className=\"bg-white rounded-lg shadow-sm p-6\">\n          <p className=\"font-body text-sm text-ink/60 mb-2\">Under Review</p>\n          <p className=\"font-heading text-3xl text-gold\">{stats?.under_review || 0}</p>\n        </div>\n        <div className=\"bg-white rounded-lg shadow-sm p-6\">\n          <p className=\"font-body text-sm text-ink/60 mb-2\">Approved</p>\n          <p className=\"font-heading text-3xl text-teal\">{stats?.approved || 0}</p>\n        </div>\n        <div className=\"bg-white rounded-lg shadow-sm p-6\">\n          <p className=\"font-body text-sm text-ink/60 mb-2\">Pending</p>\n          <p className=\"font-heading text-3xl text-ink\">{stats?.pending || 0}</p>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nexport default Dashboard;\n"
  },
