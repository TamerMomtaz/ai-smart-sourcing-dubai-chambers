    "path": "src/pages/TrendAnalysesList.jsx",
    "content": "import React, { useEffect, useState } from 'react';\nimport { useSearchParams } from 'react-router-dom';\nimport api, { getErrorMessage } from '../lib/api';\n\nconst TrendAnalysesList = () => {\n  const [searchParams, setSearchParams] = useSearchParams();\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState(null);\n  const [analyses, setAnalyses] = useState([]);\n  const [pagination, setPagination] = useState(null);\n\n  const page = parseInt(searchParams.get('page') || '1', 10);\n  const pageSize = 20;\n\n  useEffect(() => {\n    fetchAnalyses();\n  }, [page]);\n\n  const fetchAnalyses = async () => {\n    try {\n      setLoading(true);\n      setError(null);\n      const res = await api.get(`/trend-analyses?page=${page}&page_size=${pageSize}`);\n      setAnalyses(res.data.analyses || []);\n      setPagination(res.data.pagination);\n    } catch (err) {\n      setError(getErrorMessage(err));\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handlePageChange = (newPage) => {\n    setSearchParams({ page: newPage.toString() });\n  };\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-cream flex items-center justify-center\">\n        <div className=\"animate-pulse text-teal font-heading text-2xl\">Loading trend analyses...</div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-cream p-8\">\n      <div className=\"max-w-7xl mx-auto\">\n        <header className=\"mb-6\">\n          <h1 className=\"font-heading text-4xl text-teal\">Trend Analyses</h1>\n        </header>\n\n        {error && (\n          <div className=\"bg-burgundy/10 border border-burgundy rounded-lg p-4 mb-6\">\n            <p className=\"text-burgundy\">{error}</p>\n          </div>\n        )}\n\n        <div className=\"space-y-6\">\n          {analyses.length === 0 ? (\n            <div className=\"bg-white rounded-xl shadow-md p-8 text-center text-ink/60\">\n              No trend analyses found\n            </div>\n          ) : (\n            analyses.map((a) => (\n              <div key={a.id} className=\"bg-white rounded-xl shadow-md p-6\">\n                <div className=\"flex items-start justify-between mb-4\">\n                  <div>\n                    <h3 className=\"font-heading text-xl text-teal mb-1\">\n                      {a.sector ? `${a.sector} Sector` : 'Cross-Sector'} Analysis\n                    </h3>\n                    <p className=\"text-sm text-ink/60\">\n                      {new Date(a.analysis_date).toLocaleDateString()} \u2022 {a.submission_volume} proposals analyzed\n                    </p>\n                  </div>\n                  <span className=\"text-xs text-ink/50\">Generated by {a.generated_by}</span>\n                </div>\n                {a.emerging_technologies && a.emerging_technologies.length > 0 && (\n                  <div className=\"mb-4\">\n                    <h4 className=\"text-sm font-medium text-ink mb-2\">Emerging Technologies:</h4>\n                    <div className=\"flex flex-wrap gap-2\">\n                      {a.emerging_technologies.map((tech, i) => (\n                        <span key={i} className=\"bg-gold/20 text-gold px-3 py-1 rounded-full text-xs font-medium\">\n                          {tech}\n                        </span>\n                      ))}\n                    </div>\n                  </div>\n                )}\n                {a.average_scores && (\n                  <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n                    {Object.entries(a.average_scores).map(([key, val]) => (\n                      <div key={key} className=\"border border-cream rounded-lg p-3\">\n                        <div className=\"text-xs text-ink/60 mb-1 capitalize\">{key.replace('_', ' ')}</div>\n                        <div className=\"font-heading text-xl text-teal\">{val?.toFixed(1) || 'N/A'}</div>\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </div>\n            ))\n          )}\n        </div>\n\n        {pagination && pagination.total_pages > 1 && (\n          <div className=\"flex items-center justify-center space-x-2 mt-6\">\n            <button\n              onClick={() => handlePageChange(page - 1)}\n              disabled={page === 1}\n              className=\"px-4 py-2 rounded-lg bg-white border border-cream disabled:opacity-50 hover:bg-cream transition\"\n            >\n              Previous\n            </button>\n            <span className=\"text-ink\">\n              Page {page} of {pagination.total_pages}\n            </span>\n            <button\n              onClick={() => handlePageChange(page + 1)}\n              disabled={page === pagination.total_pages}\n              className=\"px-4 py-2 rounded-lg bg-white border border-cream disabled:opacity-50 hover:bg-cream transition\"\n            >\n              Next\n            </button>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default TrendAnalysesList;"
  },
  {
    "path": "src/pages/AIInteractionsList.jsx",
    "content": "import React, { useEffect, useState } from 'react';\nimport { useSearchParams } from 'react-router-dom';\nimport api, { getErrorMessage } from '../lib/api';\n\nconst AIInteractionsList = () => {\n  const [searchParams, setSearchParams] = useSearchParams();\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState(null);\n  const [interactions, setInteractions] = useState([]);\n  const [pagination, setPagination] = useState(null);\n\n  const page = parseInt(searchParams.get('page') || '1', 10);\n  const pageSize = 50;\n\n  useEffect(() => {\n    fetchInteractions();\n  }, [page]);\n\n  const fetchInteractions = async () => {\n    try {\n      setLoading(true);\n      setError(null);\n      const res = await api.get(`/ai-interactions?page=${page}&page_size=${pageSize}`);\n      setInteractions(res.data.interactions || []);\n      setPagination(res.data.pagination);\n    } catch (err) {\n      setError(getErrorMessage(err));\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handlePageChange = (newPage) => {\n    setSearchParams({ page: newPage.toString() });\n  };\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-cream flex items-center justify-center\">\n        <div className=\"animate-pulse text-teal font-heading text-2xl\">Loading AI interactions...</div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-cream p-8\">\n      <div className=\"max-w-7xl mx-auto\">\n        <header className=\"mb-6\">\n          <h1 className=\"font-heading text-4xl text-teal\">AI Interactions (\u03a3I Tracking)</h1>\n        </header>\n\n        {error && (\n          <div className=\"bg-burgundy/10 border border-burgundy rounded-lg p-4 mb-6\">\n            <p className=\"text-burgundy\">{error}</p>\n          </div>\n        )}\n\n        <div className=\"bg-white rounded-xl shadow-md overflow-hidden\">\n          <table className=\"w-full text-sm\">\n            <thead className=\"bg-teal text-white\">\n              <tr>\n                <th className=\"text-left p-3\">Timestamp</th>\n                <th className=\"text-left p-3\">Model</th>\n                <th className=\"text-left p-3\">Operation</th>\n                <th className=\"text-left p-3\">Tokens</th>\n                <th className=\"text-left p-3\">Latency</th>\n                <th className=\"text-left p-3\">Cost</th>\n                <th className=\"text-left p-3\">\u03a3I Units</th>\n              </tr>\n            </thead>\n            <tbody>\n              {interactions.length === 0 ? (\n                <tr>\n                  <td colSpan={7} className=\"text-center p-8 text-ink/60\">\n                    No AI interactions found\n                  </td>\n                </tr>\n              ) : (\n                interactions.map((i) => (\n                  <tr key={i.id} className=\"border-b border-cream hover:bg-cream/50\">\n                    <td className=\"p-3\">\n                      {new Date(i.timestamp).toLocaleString()}\n                    </td>\n                    <td className=\"p-3 font-mono text-xs\">{i.model_name}</td>\n                    <td className=\"p-3 capitalize\">{i.operation_type}</td>\n                    <td className=\"p-3\">\n                      {i.prompt_tokens + i.completion_tokens}\n                      <span className=\"text-ink/50 text-xs ml-1\">({i.prompt_tokens}+{i.completion_tokens})</span>\n                    </td>\n                    <td className=\"p-3\">{i.latency_ms}ms</td>\n                    <td className=\"p-3\">${i.cost_usd?.toFixed(4) || '0.0000'}</td>\n                    <td className=\"p-3 font-bold text-teal\">{i.intelligence_units?.toFixed(2) || 'N/A'}</td>\n                  </tr>\n                ))\n              )}\n            </tbody>\n          </table>\n        </div>\n\n        {pagination && pagination.total_pages > 1 && (\n          <div className=\"flex items-center justify-center space-x-2 mt-6\">\n            <button\n              onClick={() => handlePageChange(page - 1)}\n              disabled={page === 1}\n              className=\"px-4 py-2 rounded-lg bg-white border border-cream disabled:opacity-50 hover:bg-cream transition\"\n            >\n              Previous\n            </button>\n            <span className=\"text-ink\">\n              Page {page} of {pagination.total_pages}\n            </span>\n            <button\n              onClick={() => handlePageChange(page + 1)}\n              disabled={page === pagination.total_pages}\n              className=\"px-4 py-2 rounded-lg bg-white border border-cream disabled:opacity-50 hover:bg-cream transition\"\n            >\n              Next\n            </button>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default AIInteractionsList;"
  },
