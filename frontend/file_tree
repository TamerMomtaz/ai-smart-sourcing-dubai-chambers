    "path": "src/App.jsx",
    "content": "import React from 'react';\nimport { BrowserRouter, Routes, Route, Navigate } from 'react-router-dom';\nimport { AuthProvider, useAuth } from './lib/auth';\nimport Layout from './components/Layout';\nimport ErrorBoundary from './components/ErrorBoundary';\nimport Login from './pages/Login';\nimport Register from './pages/Register';\nimport Dashboard from './pages/Dashboard';\nimport NotFound from './components/NotFound';\n\n// Entity pages (placeholders for now, will be generated separately)\nimport ProposalsPage from './pages/ProposalsPage';\nimport VendorsPage from './pages/VendorsPage';\nimport EvaluationsPage from './pages/EvaluationsPage';\nimport ComplianceAuditsPage from './pages/ComplianceAuditsPage';\nimport DocumentsPage from './pages/DocumentsPage';\nimport CommentsPage from './pages/CommentsPage';\nimport BusinessGroupsPage from './pages/BusinessGroupsPage';\nimport TrendAnalysesPage from './pages/TrendAnalysesPage';\nimport AIInteractionsPage from './pages/AIInteractionsPage';\nimport UsersPage from './pages/UsersPage';\n\nconst ProtectedRoute = ({ children }) => {\n  const { user, loading } = useAuth();\n\n  if (loading) {\n    return (\n      <div className=\"flex items-center justify-center min-h-screen bg-cream\">\n        <div className=\"text-center\">\n          <div className=\"animate-spin rounded-full h-12 w-12 border-b-2 border-teal mx-auto mb-4\"></div>\n          <p className=\"text-ink font-body\">Loading...</p>\n        </div>\n      </div>\n    );\n  }\n\n  if (!user) {\n    return <Navigate to=\"/login\" replace />;\n  }\n\n  return children;\n};\n\nfunction AppRoutes() {\n  return (\n    <Routes>\n      <Route path=\"/login\" element={<Login />} />\n      <Route path=\"/register\" element={<Register />} />\n      <Route\n        path=\"/dashboard\"\n        element={\n          <ProtectedRoute>\n            <Layout>\n              <Dashboard />\n            </Layout>\n          </ProtectedRoute>\n        }\n      />\n      <Route\n        path=\"/proposals\"\n        element={\n          <ProtectedRoute>\n            <Layout>\n              <ProposalsPage />\n            </Layout>\n          </ProtectedRoute>\n        }\n      />\n      <Route\n        path=\"/vendors\"\n        element={\n          <ProtectedRoute>\n            <Layout>\n              <VendorsPage />\n            </Layout>\n          </ProtectedRoute>\n        }\n      />\n      <Route\n        path=\"/evaluations\"\n        element={\n          <ProtectedRoute>\n            <Layout>\n              <EvaluationsPage />\n            </Layout>\n          </ProtectedRoute>\n        }\n      />\n      <Route\n        path=\"/compliance-audits\"\n        element={\n          <ProtectedRoute>\n            <Layout>\n              <ComplianceAuditsPage />\n            </Layout>\n          </ProtectedRoute>\n        }\n      />\n      <Route\n        path=\"/documents\"\n        element={\n          <ProtectedRoute>\n            <Layout>\n              <DocumentsPage />\n            </Layout>\n          </ProtectedRoute>\n        }\n      />\n      <Route\n        path=\"/comments\"\n        element={\n          <ProtectedRoute>\n            <Layout>\n              <CommentsPage />\n            </Layout>\n          </ProtectedRoute>\n        }\n      />\n      <Route\n        path=\"/business-groups\"\n        element={\n          <ProtectedRoute>\n            <Layout>\n              <BusinessGroupsPage />\n            </Layout>\n          </ProtectedRoute>\n        }\n      />\n      <Route\n        path=\"/trend-analyses\"\n        element={\n          <ProtectedRoute>\n            <Layout>\n              <TrendAnalysesPage />\n            </Layout>\n          </ProtectedRoute>\n        }\n      />\n      <Route\n        path=\"/ai-interactions\"\n        element={\n          <ProtectedRoute>\n            <Layout>\n              <AIInteractionsPage />\n            </Layout>\n          </ProtectedRoute>\n        }\n      />\n      <Route\n        path=\"/users\"\n        element={\n          <ProtectedRoute>\n            <Layout>\n              <UsersPage />\n            </Layout>\n          </ProtectedRoute>\n        }\n      />\n      <Route path=\"/\" element={<Navigate to=\"/dashboard\" replace />} />\n      <Route path=\"*\" element={<NotFound />} />\n    </Routes>\n  );\n}\n\nfunction App() {\n  return (\n    <ErrorBoundary>\n      <AuthProvider>\n        <BrowserRouter>\n          <AppRoutes />\n        </BrowserRouter>\n      </AuthProvider>\n    </ErrorBoundary>\n  );\n}\n\nexport default App;\n"
  },
