    "path": "src/pages/BusinessGroupDetail.jsx",
    "content": "import React, { useState, useEffect } from 'react';\nimport { useParams, useNavigate } from 'react-router-dom';\nimport axios from '../lib/axios';\nimport { getErrorMessage } from '../lib/api';\n\nconst BusinessGroupDetail = () => {\n  const { id } = useParams();\n  const navigate = useNavigate();\n  const [group, setGroup] = useState(null);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState('');\n\n  useEffect(() => {\n    fetchBusinessGroup();\n  }, [id]);\n\n  const fetchBusinessGroup = async () => {\n    try {\n      setLoading(true);\n      const { data } = await axios.get(`/api/v1/business-groups/${id}`);\n      setGroup(data);\n    } catch (err) {\n      setError(getErrorMessage(err));\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-cream flex items-center justify-center\">\n        <div className=\"text-teal font-heading text-xl\">Loading business group...</div>\n      </div>\n    );\n  }\n\n  if (error) {\n    return (\n      <div className=\"min-h-screen bg-cream flex items-center justify-center\">\n        <div className=\"text-burgundy font-body text-lg\">{error}</div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-cream p-8\">\n      <div className=\"max-w-5xl mx-auto\">\n        <div className=\"mb-6 flex items-center justify-between\">\n          <h1 className=\"font-heading text-4xl text-ink\">{group.name}</h1>\n          <button\n            onClick={() => navigate('/business-groups')}\n            className=\"text-teal hover:underline font-body\"\n          >\n            \u2190 Back to Business Groups\n          </button>\n        </div>\n\n        <div className=\"bg-white rounded-xl shadow-sm p-8 space-y-6\">\n          <div className=\"grid grid-cols-2 gap-6\">\n            <div>\n              <span className=\"text-gray-600 font-body text-sm\">Chamber</span>\n              <p className=\"text-ink font-semibold mt-1\">{group.chamber || 'N/A'}</p>\n            </div>\n            <div>\n              <span className=\"text-gray-600 font-body text-sm\">Description</span>\n              <p className=\"text-ink font-semibold mt-1\">{group.description || 'N/A'}</p>\n            </div>\n          </div>\n\n          {group.evaluation_weight_config_json && (\n            <div className=\"border-t pt-6\">\n              <h3 className=\"font-heading text-2xl text-ink mb-4\">Evaluation Weights</h3>\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div>\n                  <span className=\"text-gray-600 font-body text-sm\">Relevance</span>\n                  <p className=\"text-teal font-bold text-2xl mt-1\">{(group.evaluation_weight_config_json.relevance_weight * 100).toFixed(0)}%</p>\n                </div>\n                <div>\n                  <span className=\"text-gray-600 font-body text-sm\">Feasibility</span>\n                  <p className=\"text-teal font-bold text-2xl mt-1\">{(group.evaluation_weight_config_json.feasibility_weight * 100).toFixed(0)}%</p>\n                </div>\n                <div>\n                  <span className=\"text-gray-600 font-body text-sm\">Sector Alignment</span>\n                  <p className=\"text-teal font-bold text-2xl mt-1\">{(group.evaluation_weight_config_json.sector_alignment_weight * 100).toFixed(0)}%</p>\n                </div>\n                <div>\n                  <span className=\"text-gray-600 font-body text-sm\">Compliance</span>\n                  <p className=\"text-teal font-bold text-2xl mt-1\">{(group.evaluation_weight_config_json.compliance_weight * 100).toFixed(0)}%</p>\n                </div>\n              </div>\n            </div>\n          )}\n\n          <div className=\"border-t pt-6 flex gap-4\">\n            <button\n              onClick={() => navigate(`/business-groups/${id}/edit`)}\n              className=\"bg-teal text-white py-2 px-6 rounded-lg font-semibold hover:bg-teal/90 transition-colors\"\n            >\n              Configure Weights\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default BusinessGroupDetail;"
  },
  {
    "path": "src/pages/EvaluationDetail.jsx",
    "content": "import React, { useState, useEffect } from 'react';\nimport { useParams, useNavigate } from 'react-router-dom';\nimport axios from '../lib/axios';\nimport { getErrorMessage } from '../lib/api';\n\nconst EvaluationDetail = () => {\n  const { id } = useParams();\n  const navigate = useNavigate();\n  const [evaluation, setEvaluation] = useState(null);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState('');\n\n  useEffect(() => {\n    fetchEvaluation();\n  }, [id]);\n\n  const fetchEvaluation = async () => {\n    try {\n      setLoading(true);\n      const { data } = await axios.get(`/api/v1/evaluations/${id}`);\n      setEvaluation(data);\n    } catch (err) {\n      setError(getErrorMessage(err));\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-cream flex items-center justify-center\">\n        <div className=\"text-teal font-heading text-xl\">Loading evaluation...</div>\n      </div>\n    );\n  }\n\n  if (error) {\n    return (\n      <div className=\"min-h-screen bg-cream flex items-center justify-center\">\n        <div className=\"text-burgundy font-body text-lg\">{error}</div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-cream p-8\">\n      <div className=\"max-w-5xl mx-auto\">\n        <div className=\"mb-6 flex items-center justify-between\">\n          <h1 className=\"font-heading text-4xl text-ink\">Evaluation Detail</h1>\n          <button\n            onClick={() => navigate('/evaluations')}\n            className=\"text-teal hover:underline font-body\"\n          >\n            \u2190 Back to Evaluations\n          </button>\n        </div>\n\n        <div className=\"bg-white rounded-xl shadow-sm p-8 space-y-6\">\n          <div className=\"grid grid-cols-2 gap-6\">\n            <div>\n              <span className=\"text-gray-600 font-body text-sm\">Composite Score</span>\n              <p className=\"text-teal font-bold text-3xl mt-1\">{evaluation.composite_score}/100</p>\n            </div>\n            <div>\n              <span className=\"text-gray-600 font-body text-sm\">Evaluated At</span>\n              <p className=\"text-ink font-semibold mt-1\">\n                {evaluation.evaluated_at ? new Date(evaluation.evaluated_at).toLocaleString() : 'N/A'}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"border-t pt-6\">\n            <h3 className=\"font-heading text-2xl text-ink mb-4\">Score Breakdown</h3>\n            <div className=\"space-y-4\">\n              <div>\n                <div className=\"flex justify-between mb-2\">\n                  <span className=\"text-ink font-semibold\">Relevance</span>\n                  <span className=\"text-teal font-bold\">{evaluation.relevance_score}/100</span>\n                </div>\n                <p className=\"text-gray-600 text-sm\">{evaluation.relevance_reasoning}</p>\n              </div>\n              <div>\n                <div className=\"flex justify-between mb-2\">\n                  <span className=\"text-ink font-semibold\">Feasibility</span>\n                  <span className=\"text-teal font-bold\">{evaluation.feasibility_score}/100</span>\n                </div>\n                <p className=\"text-gray-600 text-sm\">{evaluation.feasibility_reasoning}</p>\n              </div>\n              <div>\n                <div className=\"flex justify-between mb-2\">\n                  <span className=\"text-ink font-semibold\">Sector Alignment</span>\n                  <span className=\"text-teal font-bold\">{evaluation.sector_alignment_score}/100</span>\n                </div>\n                <p className=\"text-gray-600 text-sm\">{evaluation.sector_reasoning}</p>\n              </div>\n              <div>\n                <div className=\"flex justify-between mb-2\">\n                  <span className=\"text-ink font-semibold\">Compliance</span>\n                  <span className=\"text-teal font-bold\">{evaluation.compliance_score}/100</span>\n                </div>\n                <p className=\"text-gray-600 text-sm\">{evaluation.compliance_reasoning}</p>\n              </div>\n            </div>\n          </div>\n\n          {evaluation.summary_en && (\n            <div className=\"border-t pt-6\">\n              <h3 className=\"font-heading text-2xl text-ink mb-4\">Summary (English)</h3>\n              <p className=\"text-gray-700\">{evaluation.summary_en}</p>\n            </div>\n          )}\n\n          {evaluation.summary_ar && (\n            <div className=\"border-t pt-6\">\n              <h3 className=\"font-heading text-2xl text-ink mb-4\">Summary (Arabic)</h3>\n              <p className=\"text-gray-700\" dir=\"rtl\">{evaluation.summary_ar}</p>\n            </div>\n          )}\n\n          <div className=\"border-t pt-6\">\n            <div className=\"flex items-center gap-4\">\n              <div>\n                <span className=\"text-gray-600 font-body text-sm\">Hallucination Check</span>\n                <p className=\"text-ink font-semibold mt-1\">{evaluation.hallucination_check_passed ? '\u2713 Passed' : '\u2717 Failed'}</p>\n              </div>\n              <div>\n                <span className=\"text-gray-600 font-body text-sm\">Prompt Injection</span>\n                <p className=\"text-ink font-semibold mt-1\">{evaluation.prompt_injection_detected ? '\u26a0 Detected' : '\u2713 None'}</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default EvaluationDetail;"
  },
  {
    "path": "src/pages/ComplianceAuditForm.jsx",
    "content": "import React, { useState } from 'react';\nimport { useNavigate } from 'react-router-dom';\nimport axios from '../lib/axios';\nimport { getErrorMessage } from '../lib/api';\n\nconst ComplianceAuditForm = () => {\n  const navigate = useNavigate();\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState('');\n  const [formData, setFormData] = useState({\n    proposal_id: '',\n    audit_type: 'comprehensive'\n  });\n\n  const handleChange = (e) => {\n    const { name, value } = e.target;\n    setFormData(prev => ({ ...prev, [name]: value }));\n  };\n\n  const handleSubmit = async (e) => {\n    e.preventDefault();\n    setError('');\n\n    if (!formData.proposal_id.trim()) {\n      setError('Proposal ID is required');\n      return;\n    }\n\n    try {\n      setLoading(true);\n      await axios.post('/api/v1/compliance-audits', formData);\n      navigate('/compliance-audits');\n    } catch (err) {\n      setError(getErrorMessage(err));\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-cream p-8\">\n      <div className=\"max-w-3xl mx-auto\">\n        <h1 className=\"font-heading text-4xl text-ink mb-8\">Trigger Compliance Audit</h1>\n\n        {error && (\n          <div className=\"mb-6 p-4 bg-burgundy/10 border border-burgundy rounded-lg text-burgundy\">\n            {error}\n          </div>\n        )}\n\n        <form onSubmit={handleSubmit} className=\"bg-white rounded-xl shadow-sm p-8 space-y-6\">\n          <div>\n            <label className=\"block text-ink font-body font-semibold mb-2\">Proposal ID</label>\n            <input\n              type=\"text\"\n              name=\"proposal_id\"\n              value={formData.proposal_id}\n              onChange={handleChange}\n              className=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal\"\n              required\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-ink font-body font-semibold mb-2\">Audit Type</label>\n            <select\n              name=\"audit_type\"\n              value={formData.audit_type}\n              onChange={handleChange}\n              className=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal\"\n            >\n              <option value=\"isr_v3\">ISR v3</option>\n              <option value=\"ai_security_policy\">AI Security Policy</option>\n              <option value=\"csp_standards\">CSP Standards</option>\n              <option value=\"comprehensive\">Comprehensive</option>\n            </select>\n          </div>\n\n          <div className=\"flex gap-4 pt-4\">\n            <button\n              type=\"submit\"\n              disabled={loading}\n              className=\"flex-1 bg-teal text-white py-3 px-6 rounded-lg font-semibold hover:bg-teal/90 disabled:opacity-50 disabled:cursor-not-allowed transition-colors\"\n            >\n              {loading ? 'Triggering...' : 'Trigger Audit'}\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => navigate('/compliance-audits')}\n              className=\"flex-1 bg-gray-200 text-ink py-3 px-6 rounded-lg font-semibold hover:bg-gray-300 transition-colors\"\n            >\n              Cancel\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};\n\nexport default ComplianceAuditForm;"
  },
  {
    "path": "src/pages/ComplianceAuditDetail.jsx",
    "content": "import React, { useState, useEffect } from 'react';\nimport { useParams, useNavigate } from 'react-router-dom';\nimport axios from '../lib/axios';\nimport { getErrorMessage } from '../lib/api';\n\nconst ComplianceAuditDetail = () => {\n  const { id } = useParams();\n  const navigate = useNavigate();\n  const [audit, setAudit] = useState(null);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState('');\n  const [downloadLoading, setDownloadLoading] = useState(false);\n\n  useEffect(() => {\n    fetchAudit();\n  }, [id]);\n\n  const fetchAudit = async () => {\n    try {\n      setLoading(true);\n      const { data } = await axios.get(`/api/v1/compliance-audits/${id}`);\n      setAudit(data);\n    } catch (err) {\n      setError(getErrorMessage(err));\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleDownloadReport = async () => {\n    try {\n      setDownloadLoading(true);\n      const { data } = await axios.get(`/api/v1/compliance-audits/${id}/report`, {\n        responseType: 'blob'\n      });\n      const url = window.URL.createObjectURL(new Blob([data]));\n      const link = document.createElement('a');\n      link.href = url;\n      link.setAttribute('download', `compliance-audit-${id}.pdf`);\n      document.body.appendChild(link);\n      link.click();\n      link.remove();\n    } catch (err) {\n      setError(getErrorMessage(err));\n    } finally {\n      setDownloadLoading(false);\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-cream flex items-center justify-center\">\n        <div className=\"text-teal font-heading text-xl\">Loading audit...</div>\n      </div>\n    );\n  }\n\n  if (error && !audit) {\n    return (\n      <div className=\"min-h-screen bg-cream flex items-center justify-center\">\n        <div className=\"text-burgundy font-body text-lg\">{error}</div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-cream p-8\">\n      <div className=\"max-w-5xl mx-auto\">\n        <div className=\"mb-6 flex items-center justify-between\">\n          <h1 className=\"font-heading text-4xl text-ink\">Compliance Audit</h1>\n          <button\n            onClick={() => navigate('/compliance-audits')}\n            className=\"text-teal hover:underline font-body\"\n          >\n            \u2190 Back to Audits\n          </button>\n        </div>\n\n        {error && (\n          <div className=\"mb-6 p-4 bg-burgundy/10 border border-burgundy rounded-lg text-burgundy\">\n            {error}\n          </div>\n        )}\n\n        <div className=\"bg-white rounded-xl shadow-sm p-8 space-y-6\">\n          <div className=\"grid grid-cols-2 gap-6\">\n            <div>\n              <span className=\"text-gray-600 font-body text-sm\">Audit Type</span>\n              <p className=\"text-ink font-semibold mt-1\">{audit.audit_type}</p>\n            </div>\n            <div>\n              <span className=\"text-gray-600 font-body text-sm\">Audit Timestamp</span>\n              <p className=\"text-ink font-semibold mt-1\">\n                {audit.audit_timestamp ? new Date(audit.audit_timestamp).toLocaleString() : 'N/A'}\n              </p>\n            </div>\n            <div>\n              <span className=\"text-gray-600 font-body text-sm\">ISR v3 Compliance</span>\n              <p className=\"text-ink font-semibold mt-1\">{audit.isr_v3_compliance ? '\u2713 Pass' : '\u2717 Fail'}</p>\n            </div>\n            <div>\n              <span className=\"text-gray-600 font-body text-sm\">AI Security Policy</span>\n              <p className=\"text-ink font-semibold mt-1\">{audit.ai_security_policy_compliance ? '\u2713 Pass' : '\u2717 Fail'}</p>\n            </div>\n            <div>\n              <span className=\"text-gray-600 font-body text-sm\">CSP Standards</span>\n              <p className=\"text-ink font-semibold mt-1\">{audit.csp_standards_compliance ? '\u2713 Pass' : '\u2717 Fail'}</p>\n            </div>\n            <div>\n              <span className=\"text-gray-600 font-body text-sm\">Data Residency</span>\n              <p className=\"text-ink font-semibold mt-1\">{audit.data_residency_verified ? '\u2713 Verified' : '\u2717 Not Verified'}</p>\n            </div>\n            <div>\n              <span className=\"text-gray-600 font-body text-sm\">Remediation Required</span>\n              <p className=\"text-ink font-semibold mt-1\">{audit.remediation_required ? 'Yes' : 'No'}</p>\n            </div>\n          </div>\n\n          {audit.findings_json && (\n            <div className=\"border-t pt-6\">\n              <h3 className=\"font-heading text-2xl text-ink mb-4\">Findings</h3>\n              <pre className=\"bg-gray-50 p-4 rounded-lg overflow-x-auto text-sm\">\n                {JSON.stringify(audit.findings_json, null, 2)}\n              </pre>\n            </div>\n          )}\n\n          <div className=\"border-t pt-6 flex gap-4\">\n            <button\n              onClick={handleDownloadReport}\n              disabled={downloadLoading}\n              className=\"bg-teal text-white py-2 px-6 rounded-lg font-semibold hover:bg-teal/90 disabled:opacity-50 transition-colors\"\n            >\n              {downloadLoading ? 'Downloading...' : 'Download Report'}\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default ComplianceAuditDetail;"
  },
  {
    "path": "src/pages/DocumentDetail.jsx",
    "content": "import React, { useState, useEffect } from 'react';\nimport { useParams, useNavigate } from 'react-router-dom';\nimport axios from '../lib/axios';\nimport { getErrorMessage } from '../lib/api';\n\nconst DocumentDetail = () => {\n  const { id } = useParams();\n  const navigate = useNavigate();\n  const [document, setDocument] = useState(null);\n  const [extractedData, setExtractedData] = useState(null);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState('');\n  const [downloadLoading, setDownloadLoading] = useState(false);\n\n  useEffect(() => {\n    fetchDocument();\n    fetchExtractedData();\n  }, [id]);\n\n  const fetchDocument = async () => {\n    try {\n      setLoading(true);\n      const { data } = await axios.get(`/api/v1/documents/${id}`);\n      setDocument(data);\n    } catch (err) {\n      setError(getErrorMessage(err));\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const fetchExtractedData = async () => {\n    try {\n      const { data } = await axios.get(`/api/v1/documents/${id}/extracted-data`);\n      setExtractedData(data);\n    } catch (err) {\n      console.error('Failed to fetch extracted data:', err);\n    }\n  };\n\n  const handleDownload = async () => {\n    try {\n      setDownloadLoading(true);\n      const { data } = await axios.get(`/api/v1/documents/${id}/download`);\n      window.open(data.download_url, '_blank');\n    } catch (err) {\n      setError(getErrorMessage(err));\n    } finally {\n      setDownloadLoading(false);\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-cream flex items-center justify-center\">\n        <div className=\"text-teal font-heading text-xl\">Loading document...</div>\n      </div>\n    );\n  }\n\n  if (error && !document) {\n    return (\n      <div className=\"min-h-screen bg-cream flex items-center justify-center\">\n        <div className=\"text-burgundy font-body text-lg\">{error}</div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-cream p-8\">\n      <div className=\"max-w-5xl mx-auto\">\n        <div className=\"mb-6 flex items-center justify-between\">\n          <h1 className=\"font-heading text-4xl text-ink\">{document.file_name}</h1>\n          <button\n            onClick={() => navigate('/documents')"
  },
  {
    "path": "src/pages/Settings.jsx",
    "content": "import React, { useState, useEffect } from 'react';\nimport { useNavigate } from 'react-router-dom';\nimport axios from 'axios';\nimport { getErrorMessage } from '../lib/api';\n\nconst Settings = () => {\n  const navigate = useNavigate();\n  const [loading, setLoading] = useState(true);\n  const [saving, setSaving] = useState(false);\n  const [error, setError] = useState(null);\n  const [success, setSuccess] = useState(null);\n  const [user, setUser] = useState(null);\n  const [notifications, setNotifications] = useState({\n    email_enabled: true,\n    proposal_status_updates: true,\n    weekly_digest: true,\n    compliance_alerts: true\n  });\n  const [profile, setProfile] = useState({\n    full_name: '',\n    preferred_language: 'en'\n  });\n\n  useEffect(() => {\n    fetchUserData();\n  }, []);\n\n  const fetchUserData = async () => {\n    setLoading(true);\n    setError(null);\n    try {\n      const response = await axios.get('/api/v1/users/me');\n      setUser(response.data);\n      setProfile({\n        full_name: response.data.full_name || '',\n        preferred_language: response.data.preferred_language || 'en'\n      });\n      if (response.data.notification_preferences) {\n        setNotifications(response.data.notification_preferences);\n      }\n    } catch (err) {\n      setError(getErrorMessage(err));\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleProfileUpdate = async (e) => {\n    e.preventDefault();\n    setSaving(true);\n    setError(null);\n    setSuccess(null);\n    try {\n      await axios.patch('/api/v1/users/me', profile);\n      setSuccess('Profile updated successfully');\n      setTimeout(() => setSuccess(null), 3000);\n    } catch (err) {\n      setError(getErrorMessage(err));\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const handleNotificationUpdate = async (e) => {\n    e.preventDefault();\n    setSaving(true);\n    setError(null);\n    setSuccess(null);\n    try {\n      await axios.patch('/api/v1/users/me', {\n        notification_preferences: notifications\n      });\n      setSuccess('Notification preferences updated successfully');\n      setTimeout(() => setSuccess(null), 3000);\n    } catch (err) {\n      setError(getErrorMessage(err));\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const handleSignOut = () => {\n    localStorage.removeItem('token');\n    localStorage.removeItem('refresh_token');\n    navigate('/login');\n  };\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-cream flex items-center justify-center\">\n        <div className=\"animate-spin rounded-full h-12 w-12 border-b-2 border-teal\"></div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-cream py-8\">\n      <div className=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"mb-8\">\n          <h1 className=\"text-4xl font-heading font-bold text-ink mb-2\">Settings</h1>\n          <p className=\"text-ink/60 font-body\">Manage your account preferences and notification settings</p>\n        </div>\n\n        {error && (\n          <div className=\"mb-6 p-4 bg-burgundy/10 border border-burgundy rounded-lg\">\n            <p className=\"text-burgundy font-body\">{error}</p>\n          </div>\n        )}\n\n        {success && (\n          <div className=\"mb-6 p-4 bg-teal/10 border border-teal rounded-lg\">\n            <p className=\"text-teal font-body\">{success}</p>\n          </div>\n        )}\n\n        {/* User Info Card */}\n        <div className=\"bg-white rounded-xl shadow-sm p-6 mb-6\">\n          <h2 className=\"text-2xl font-heading font-bold text-ink mb-4\">Account Information</h2>\n          <div className=\"space-y-3\">\n            <div>\n              <label className=\"block text-sm font-body font-medium text-ink/60 mb-1\">Email</label>\n              <p className=\"font-body text-ink\">{user?.email}</p>\n            </div>\n            <div>\n              <label className=\"block text-sm font-body font-medium text-ink/60 mb-1\">Role</label>\n              <p className=\"font-body text-ink capitalize\">{user?.role?.replace('_', ' ')}</p>\n            </div>\n            <div>\n              <label className=\"block text-sm font-body font-medium text-ink/60 mb-1\">Chamber</label>\n              <p className=\"font-body text-ink\">{user?.chamber || 'N/A'}</p>\n            </div>\n            {user?.business_group && (\n              <div>\n                <label className=\"block text-sm font-body font-medium text-ink/60 mb-1\">Business Group</label>\n                <p className=\"font-body text-ink\">{user.business_group}</p>\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Profile Settings */}\n        <div className=\"bg-white rounded-xl shadow-sm p-6 mb-6\">\n          <h2 className=\"text-2xl font-heading font-bold text-ink mb-4\">Profile Settings</h2>\n          <form onSubmit={handleProfileUpdate}>\n            <div className=\"space-y-4\">\n              <div>\n                <label htmlFor=\"full_name\" className=\"block text-sm font-body font-medium text-ink mb-2\">\n                  Full Name\n                </label>\n                <input\n                  type=\"text\"\n                  id=\"full_name\"\n                  value={profile.full_name}\n                  onChange={(e) => setProfile({ ...profile, full_name: e.target.value })}\n                  className=\"w-full px-4 py-2 border border-ink/20 rounded-lg font-body text-ink focus:outline-none focus:ring-2 focus:ring-teal\"\n                  required\n                />\n              </div>\n              <div>\n                <label htmlFor=\"preferred_language\" className=\"block text-sm font-body font-medium text-ink mb-2\">\n                  Preferred Language\n                </label>\n                <select\n                  id=\"preferred_language\"\n                  value={profile.preferred_language}\n                  onChange={(e) => setProfile({ ...profile, preferred_language: e.target.value })}\n                  className=\"w-full px-4 py-2 border border-ink/20 rounded-lg font-body text-ink focus:outline-none focus:ring-2 focus:ring-teal\"\n                >\n                  <option value=\"en\">English</option>\n                  <option value=\"ar\">Arabic (\u0627\u0644\u0639\u0631\u0628\u064a\u0629)</option>\n                </select>\n              </div>\n            </div>\n            <div className=\"mt-6\">\n              <button\n                type=\"submit\"\n                disabled={saving}\n                className=\"px-6 py-2 bg-teal text-white rounded-lg font-body font-medium hover:bg-teal/90 transition disabled:opacity-50\"\n              >\n                {saving ? 'Saving...' : 'Save Profile'}\n              </button>\n            </div>\n          </form>\n        </div>\n\n        {/* Notification Preferences */}\n        <div className=\"bg-white rounded-xl shadow-sm p-6 mb-6\">\n          <h2 className=\"text-2xl font-heading font-bold text-ink mb-4\">Notification Preferences</h2>\n          <form onSubmit={handleNotificationUpdate}>\n            <div className=\"space-y-4\">\n              <div className=\"flex items-center\">\n                <input\n                  type=\"checkbox\"\n                  id=\"email_enabled\"\n                  checked={notifications.email_enabled}\n                  onChange={(e) => setNotifications({ ...notifications, email_enabled: e.target.checked })}\n                  className=\"h-4 w-4 text-teal focus:ring-teal border-ink/20 rounded\"\n                />\n                <label htmlFor=\"email_enabled\" className=\"ml-3 font-body text-ink\">\n                  Enable email notifications\n                </label>\n              </div>\n              <div className=\"flex items-center\">\n                <input\n                  type=\"checkbox\"\n                  id=\"proposal_status_updates\"\n                  checked={notifications.proposal_status_updates}\n                  onChange={(e) => setNotifications({ ...notifications, proposal_status_updates: e.target.checked })}\n                  className=\"h-4 w-4 text-teal focus:ring-teal border-ink/20 rounded\"\n                />\n                <label htmlFor=\"proposal_status_updates\" className=\"ml-3 font-body text-ink\">\n                  Proposal status updates\n                </label>\n              </div>\n              <div className=\"flex items-center\">\n                <input\n                  type=\"checkbox\"\n                  id=\"weekly_digest\"\n                  checked={notifications.weekly_digest}\n                  onChange={(e) => setNotifications({ ...notifications, weekly_digest: e.target.checked })}\n                  className=\"h-4 w-4 text-teal focus:ring-teal border-ink/20 rounded\"\n                />\n                <label htmlFor=\"weekly_digest\" className=\"ml-3 font-body text-ink\">\n                  Weekly summary digest\n                </label>\n              </div>\n              <div className=\"flex items-center\">\n                <input\n                  type=\"checkbox\"\n                  id=\"compliance_alerts\"\n                  checked={notifications.compliance_alerts}\n                  onChange={(e) => setNotifications({ ...notifications, compliance_alerts: e.target.checked })}\n                  className=\"h-4 w-4 text-teal focus:ring-teal border-ink/20 rounded\"\n                />\n                <label htmlFor=\"compliance_alerts\" className=\"ml-3 font-body text-ink\">\n                  Compliance alerts\n                </label>\n              </div>\n            </div>\n            <div className=\"mt-6\">\n              <button\n                type=\"submit\"\n                disabled={saving}\n                className=\"px-6 py-2 bg-teal text-white rounded-lg font-body font-medium hover:bg-teal/90 transition disabled:opacity-50\"\n              >\n                {saving ? 'Saving...' : 'Save Preferences'}\n              </button>\n            </div>\n          </form>\n        </div>\n\n        {/* Security Section */}\n        <div className=\"bg-white rounded-xl shadow-sm p-6\">\n          <h2 className=\"text-2xl font-heading font-bold text-ink mb-4\">Security</h2>\n          <div className=\"space-y-4\">\n            <div>\n              <p className=\"font-body text-ink/60 mb-4\">\n                Sign out from your account on this device.\n              </p>\n              <button\n                onClick={handleSignOut}\n                className=\"px-6 py-2 bg-burgundy text-white rounded-lg font-body font-medium hover:bg-burgundy/90 transition\"\n              >\n                Sign Out\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Settings;"
  },
  {
    "path": "src/components/ProposalCard.jsx",
    "content": "import React from 'react';\nimport { Link } from 'react-router-dom';\nimport StatusBadge from './StatusBadge';\nimport ScoreBadge from './ScoreBadge';\n\nconst ProposalCard = ({ proposal }) => {\n  const formatDate = (dateString) => {\n    if (!dateString) return 'N/A';\n    return new Date(dateString).toLocaleDateString('en-US', {\n      year: 'numeric',\n      month: 'short',\n      day: 'numeric'\n    });\n  };\n\n  return (\n    <Link to={`/proposals/${proposal.id}`}>\n      <div className=\"bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition cursor-pointer border border-transparent hover:border-teal\">\n        <div className=\"flex items-start justify-between mb-4\">\n          <div className=\"flex-1\">\n            <h3 className=\"text-xl font-heading font-bold text-ink mb-2 line-clamp-2\">\n              {proposal.title}\n            </h3>\n            <div className=\"flex flex-wrap gap-2 mb-3\">\n              <span className=\"inline-flex items-center px-3 py-1 rounded-full text-xs font-body font-medium bg-teal/10 text-teal\">\n                {proposal.sector}\n              </span>\n              <span className=\"inline-flex items-center px-3 py-1 rounded-full text-xs font-body font-medium bg-gold/10 text-gold\">\n                {proposal.technology_type?.replace('_', ' ')}\n              </span>\n              {proposal.maturity_level && (\n                <span className=\"inline-flex items-center px-3 py-1 rounded-full text-xs font-body font-medium bg-ink/10 text-ink\">\n                  {proposal.maturity_level}\n                </span>\n              )}\n            </div>\n          </div>\n          <StatusBadge status={proposal.status} />\n        </div>\n\n        {proposal.composite_score !== null && proposal.composite_score !== undefined && (\n          <div className=\"mb-4\">\n            <ScoreBadge score={proposal.composite_score} label=\"Composite Score\" />\n          </div>\n        )}\n\n        <div className=\"grid grid-cols-2 gap-4 text-sm font-body\">\n          <div>\n            <span className=\"text-ink/60\">Submitted:</span>\n            <p className=\"text-ink font-medium\">{formatDate(proposal.submission_date)}</p>\n          </div>\n          {proposal.evaluation_timestamp && (\n            <div>\n              <span className=\"text-ink/60\">Evaluated:</span>\n              <p className=\"text-ink font-medium\">{formatDate(proposal.evaluation_timestamp)}</p>\n            </div>\n          )}\n        </div>\n\n        {proposal.requires_manual_review && (\n          <div className=\"mt-4 p-3 bg-gold/10 border border-gold rounded-lg\">\n            <p className=\"text-xs font-body text-gold font-medium\">\u26a0\ufe0f Manual review required</p>\n          </div>\n        )}\n\n        {proposal.is_duplicate && (\n          <div className=\"mt-4 p-3 bg-burgundy/10 border border-burgundy rounded-lg\">\n            <p className=\"text-xs font-body text-burgundy font-medium\">\u26a0\ufe0f Potential duplicate detected</p>\n          </div>\n        )}\n      </div>\n    </Link>\n  );\n};\n\nexport default ProposalCard;"
  },
  {
    "path": "src/components/VendorCard.jsx",
    "content": "import React from 'react';\nimport { Link } from 'react-router-dom';\n\nconst VendorCard = ({ vendor }) => {\n  const formatDate = (dateString) => {\n    if (!dateString) return 'N/A';\n    return new Date(dateString).toLocaleDateString('en-US', {\n      year: 'numeric',\n      month: 'short',\n      day: 'numeric'\n    });\n  };\n\n  return (\n    <Link to={`/vendors/${vendor.id}`}>\n      <div className=\"bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition cursor-pointer border border-transparent hover:border-teal\">\n        <div className=\"flex items-start justify-between mb-4\">\n          <div className=\"flex-1\">\n            <h3 className=\"text-xl font-heading font-bold text-ink mb-2\">\n              {vendor.name}\n            </h3>\n            {vendor.is_desc_approved && (\n              <div className=\"inline-flex items-center px-3 py-1 rounded-full text-xs font-body font-medium bg-teal/10 text-teal mb-2\">\n                \u2713 DESC Approved\n              </div>\n            )}\n          </div>\n          {vendor.onboarding_status && (\n            <span className={`inline-flex items-center px-3 py-1 rounded-full text-xs font-body font-medium ${\n              vendor.onboarding_status === 'active' ? 'bg-teal/10 text-teal' :\n              vendor.onboarding_status === 'pending' ? 'bg-gold/10 text-gold' :\n              'bg-ink/10 text-ink'\n            }`}>\n              {vendor.onboarding_status}\n            </span>\n          )}\n        </div>\n\n        <div className=\"space-y-2 text-sm font-body mb-4\">\n          {vendor.country && (\n            <div className=\"flex items-center text-ink/60\">\n              <span className=\"mr-2\">\ud83c\udf0d</span>\n              <span>{vendor.country}</span>\n            </div>\n          )}\n          {vendor.contact_email && (\n            <div className=\"flex items-center text-ink/60\">\n              <span className=\"mr-2\">\u2709\ufe0f</span>\n              <span className=\"truncate\">{vendor.contact_email}</span>\n            </div>\n          )}\n          {vendor.website && (\n            <div className=\"flex items-center text-ink/60\">\n              <span className=\"mr-2\">\ud83d\udd17</span>\n              <span className=\"truncate\">{vendor.website}</span>\n            </div>\n          )}\n        </div>\n\n        <div className=\"grid grid-cols-2 gap-4 text-sm font-body pt-4 border-t border-ink/10\">\n          <div>\n            <span className=\"text-ink/60\">Submissions:</span>\n            <p className=\"text-ink font-medium\">{vendor.submission_history_count || 0}</p>\n          </div>\n          {vendor.average_compliance_score !== null && vendor.average_compliance_score !== undefined && (\n            <div>\n              <span className=\"text-ink/60\">Avg. Compliance:</span>\n              <p className=\"text-ink font-medium\">{vendor.average_compliance_score.toFixed(1)}%</p>\n            </div>\n          )}\n        </div>\n\n        {vendor.desc_badge_issued_date && (\n          <div className=\"mt-4 p-3 bg-teal/5 rounded-lg\">\n            <p className=\"text-xs font-body text-ink/60\">\n              DESC Badge Issued: {formatDate(vendor.desc_badge_issued_date)}\n            </p>\n          </div>\n        )}\n      </div>\n    </Link>\n  );\n};\n\nexport default VendorCard;"
  },
  {
    "path": "src/components/StatusBadge.jsx",
    "content": "import React from 'react';\n\nconst StatusBadge = ({ status }) => {\n  const getStatusStyles = (status) => {\n    const normalized = status?.toLowerCase();\n    switch (normalized) {\n      case 'draft':\n        return 'bg-ink/10 text-ink';\n      case 'submitted':\n        return 'bg-teal/10 text-teal';\n      case 'evaluating':\n      case 'in_progress':\n      case 'processing':\n        return 'bg-gold/10 text-gold';\n      case 'under_review':\n      case 'pending':\n        return 'bg-gold/10 text-gold';\n      case 'approved':\n      case 'passed':\n      case 'active':\n      case 'completed':\n        return 'bg-teal/10 text-teal';\n      case 'rejected':\n      case 'failed':\n        return 'bg-burgundy/10 text-burgundy';\n      default:\n        return 'bg-ink/10 text-ink';\n    }\n  };\n\n  const formatStatus = (status) => {\n    if (!status) return 'Unknown';\n    return status.replace(/_/g, ' ').replace(/\\b\\w/g, (l) => l.toUpperCase());\n  };\n\n  return (\n    <span className={`inline-flex items-center px-3 py-1 rounded-full text-xs font-body font-medium ${getStatusStyles(status)}`}>\n      {formatStatus(status)}\n    </span>\n  );\n};\n\nexport default StatusBadge;"
  },
  {
    "path": "src/components/ScoreBadge.jsx",
    "content": "import React from 'react';\n\nconst ScoreBadge = ({ score, label }) => {\n  const getScoreColor = (score) => {\n    if (score >= 80) return 'text-teal';\n    if (score >= 60) return 'text-gold';\n    return 'text-burgundy';\n  };\n\n  const getScoreBg = (score) => {\n    if (score >= 80) return 'bg-teal/10';\n    if (score >= 60) return 'bg-gold/10';\n    return 'bg-burgundy/10';\n  };\n\n  if (score === null || score === undefined) return null;\n\n  return (\n    <div className=\"inline-flex flex-col items-start\">\n      {label && (\n        <span className=\"text-xs font-body text-ink/60 mb-1\">{label}</span>\n      )}\n      <div className={`inline-flex items-center px-3 py-1 rounded-lg ${getScoreBg(score)}`}>\n        <span className={`text-lg font-heading font-bold ${getScoreColor(score)}`}>\n          {score.toFixed(1)}\n        </span>\n        <span className={`text-sm font-body ml-1 ${getScoreColor(score)}`}>/100</span>\n      </div>\n    </div>\n  );\n};\n\nexport default ScoreBadge;"
  },
  {
    "path": "src/components/EvaluationCard.jsx",
    "content": "import React from 'react';\nimport { Link } from 'react-router-dom';\nimport ScoreBadge from './ScoreBadge';\n\nconst EvaluationCard = ({ evaluation, proposalTitle }) => {\n  const formatDate = (dateString) => {\n    if (!dateString) return 'N/A';\n    return new Date(dateString).toLocaleDateString('en-US', {\n      year: 'numeric',\n      month: 'short',\n      day: 'numeric',\n      hour: '2-digit',\n      minute: '2-digit'\n    });\n  };\n\n  return (\n    <Link to={`/evaluations/${evaluation.id}`}>\n      <div className=\"bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition cursor-pointer border border-transparent hover:border-teal\">\n        {proposalTitle && (\n          <h3 className=\"text-lg font-heading font-bold text-ink mb-4\">\n            {proposalTitle}\n          </h3>\n        )}\n\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 mb-4\">\n          <ScoreBadge score={evaluation.composite_score} label=\"Composite\" />\n          <ScoreBadge score={evaluation.relevance_score} label=\"Relevance\" />\n          <ScoreBadge score={evaluation.feasibility_score} label=\"Feasibility\" />\n          <ScoreBadge score={evaluation.sector_alignment_score} label=\"Sector Alignment\" />\n        </div>\n\n        {evaluation.compliance_score !== null && evaluation.compliance_score !== undefined && (\n          <div className=\"mb-4\">\n            <ScoreBadge score={evaluation.compliance_score} label=\"Compliance\" />\n          </div>\n        )}\n\n        <div className=\"flex items-center justify-between text-sm font-body text-ink/60 pt-4 border-t border-ink/10\">\n          <span>Evaluated: {formatDate(evaluation.evaluated_at)}</span>\n          {evaluation.hallucination_check_passed === false && (\n            <span className=\"inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-burgundy/10 text-burgundy\">\n              \u26a0\ufe0f Hallucination Detected\n            </span>\n          )}\n          {evaluation.prompt_injection_detected && (\n            <span className=\"inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-burgundy/10 text-burgundy\">\n              \u26a0\ufe0f Prompt Injection Detected\n            </span>\n          )}\n        </div>\n      </div>\n    </Link>\n  );\n};\n\nexport default EvaluationCard;"
  },
  {
    "path": "src/components/ComplianceAuditCard.jsx",
    "content": "import React from 'react';\nimport { Link } from 'react-router-dom';\nimport StatusBadge from './StatusBadge';\n\nconst ComplianceAuditCard = ({ audit }) => {\n  const formatDate = (dateString) => {\n    if (!dateString) return 'N/A';\n    return new Date(dateString).toLocaleDateString('en-US', {\n      year: 'numeric',\n      month: 'short',\n      day: 'numeric',\n      hour: '2-digit',\n      minute: '2-digit'\n    });\n  };\n\n  const getAuditTypeLabel = (type) => {\n    const labels = {\n      isr_v3: 'ISR v3',\n      ai_security_policy: 'AI Security Policy',\n      csp_standards: 'CSP Standards',\n      comprehensive: 'Comprehensive'\n    };\n    return labels[type] || type;\n  };\n\n  const getComplianceIcon = (passed) => {\n    return passed ? '\u2713' : '\u2717';\n  };\n\n  const getComplianceColor = (passed) => {\n    return passed ? 'text-teal' : 'text-burgundy';\n  };\n\n  return (\n    <Link to={`/compliance-audits/${audit.id}`}>\n      <div className=\"bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition cursor-pointer border border-transparent hover:border-teal\">\n        <div className=\"flex items-start justify-between mb-4\">\n          <div className=\"flex-1\">\n            <h3 className=\"text-lg font-heading font-bold text-ink mb-2\">\n              {getAuditTypeLabel(audit.audit_type)} Audit\n            </h3>\n            <p className=\"text-sm font-body text-ink/60\">\n              {formatDate(audit.audit_timestamp)}\n            </p>\n          </div>\n          <StatusBadge status={audit.status || 'completed'} />\n        </div>\n\n        <div className=\"grid grid-cols-2 gap-3 mb-4\">\n          <div className=\"flex items-center space-x-2\">\n            <span className={`text-lg ${getComplianceColor(audit.isr_v3_compliance)}`}>\n              {getComplianceIcon(audit.isr_v3_compliance)}\n            </span>\n            <span className=\"text-sm font-body text-ink/60\">ISR v3</span>\n          </div>\n          <div className=\"flex items-center space-x-2\">\n            <span className={`text-lg ${getComplianceColor(audit.ai_security_policy_compliance)}`}>\n              {getComplianceIcon(audit.ai_security_policy_compliance)}\n            </span>\n            <span className=\"text-sm font-body text-ink/60\">AI Security</span>\n          </div>\n          <div className=\"flex items-center space-x-2\">\n            <span className={`text-lg ${getComplianceColor(audit.csp_standards_compliance)}`}>\n              {getComplianceIcon(audit.csp_standards_compliance)}\n            </span>\n            <span className=\"text-sm font-body text-ink/60\">CSP Standards</span>\n          </div>\n          <div className=\"flex items-center space-x-2\">\n            <span className={`text-lg ${getComplianceColor(audit.data_residency_verified)}`}>\n              {getComplianceIcon(audit.data_residency_verified)}\n            </span>\n            <span className=\"text-sm font-body text-ink/60\">Data Residency</span>\n          </div>\n        </div>\n\n        {audit.remediation_required && (\n          <div className=\"p-3 bg-gold/10 border border-gold rounded-lg\">\n            <p className=\"text-xs font-body text-gold font-medium\">\u26a0\ufe0f Remediation required</p>\n          </div>\n        )}\n\n        {audit.hash_chain_signature && (\n          <div className=\"mt-4 pt-4 border-t border-ink/10\">\n            <p className=\"text-xs font-mono text-ink/40 truncate\">\n              Hash: {audit.hash_chain_signature}\n            </p>\n          </div>\n        )}\n      </div>\n    </Link>\n  );\n};\n\nexport default ComplianceAuditCard;"
  },
  {
    "path": "src/components/DocumentCard.jsx",
    "content": "import React from 'react';\nimport { Link } from 'react-router-dom';\n\nconst DocumentCard = ({ document }) => {\n  const formatDate = (dateString) => {\n    if (!dateString) return 'N/A';\n    return new Date(dateString).toLocaleDateString('en-US', {\n      year: 'numeric',\n      month: 'short',\n      day: 'numeric',\n      hour: '2-digit',\n      minute: '2-digit'\n    });\n  };\n\n  const formatFileSize = (bytes) => {\n    if (!bytes) return 'N/A';\n    const kb = bytes / 1024;\n    const mb = kb / 1024;\n    if (mb >= 1) return `${mb.toFixed(2)} MB`;\n    return `${kb.toFixed(2)} KB`;\n  };\n\n  const getFileIcon = (fileType) => {\n    switch (fileType?.toLowerCase()) {\n      case 'pdf':\n        return '\ud83d\udcc4';\n      case 'docx':\n      case 'doc':\n        return '\ud83d\udcdd';\n      case 'pptx':\n      case 'ppt':\n        return '\ud83d\udcca';\n      case 'xlsx':\n      case 'xls':\n        return '\ud83d\udcc8';\n      default:\n        return '\ud83d\udcce';\n    }\n  };\n\n  const getFileTypeColor = (fileType) => {\n    switch (fileType?.toLowerCase()) {\n      case 'pdf':\n        return 'bg-burgundy/10 text-burgundy';\n      case 'docx':\n      case 'doc':\n        return 'bg-teal/10 text-teal';\n      case 'pptx':\n      case 'ppt':\n        return 'bg-gold/10 text-gold';\n      case 'xlsx':\n      case 'xls':\n        return 'bg-teal/10 text-teal';\n      default:\n        return 'bg-ink/10 text-ink';\n    }\n  };\n\n  return (\n    <Link to={`/documents/${document.id}`}>\n      <div className=\"bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition cursor-pointer border border-transparent hover:border-teal\">\n        <div className=\"flex items-start space-x-4\">\n          <div className=\"text-4xl\">{getFileIcon(document.file_type)}</div>\n          <div className=\"flex-1 min-w-0\">\n            <h3 className=\"text-lg font-heading font-bold text-ink mb-2 truncate\">\n              {document.file_name}\n            </h3>\n            <div className=\"flex flex-wrap gap-2 mb-3\">\n              <span className={`inline-flex items-center px-3 py-1 rounded-full text-xs font-body font-medium ${getFileTypeColor(document.file_type)}`}>\n                {document.file_type?.toUpperCase()}\n              </span>\n              <span className=\"inline-flex items-center px-3 py-1 rounded-full text-xs font-body font-medium bg-ink/10 text-ink\">\n                {formatFileSize(document.file_size)}\n              </span>\n              {document.language_detected && (\n                <span className=\"inline-flex items-center px-3 py-1 rounded-full text-xs font-body font-medium bg-teal/10 text-teal\">\n                  {document.language_detected.toUpperCase()}\n                </span>\n              )}\n            </div>\n            <p className=\"text-sm font-body text-ink/60\">\n              Uploaded: {formatDate(document.uploaded_at)}\n            </p>\n          </div>\n        </div>\n\n        {(document.extracted_text || document.extracted_tables_json || document.extracted_charts_json || document.financial_data_json) && (\n          <div className=\"mt-4 pt-4 border-t border-ink/10\">\n            <p className=\"text-xs font-body text-teal font-medium\">\u2713 AI extraction completed</p>\n          </div>\n        )}\n      </div>\n    </Link>\n  );\n};\n\nexport default DocumentCard;"
  },
  {
    "path": "src/components/CommentCard.jsx",
    "content": "import React from 'react';\n\nconst CommentCard = ({ comment }) => {\n  const formatDate = (dateString) => {\n    if (!dateString) return 'N/A';\n    return new Date(dateString).toLocaleDateString('en-US', {\n      year: 'numeric',\n      month: 'short',\n      day: 'numeric',\n      hour: '2-digit',\n      minute: '2-digit'\n    });\n  };\n\n  const getVisibilityIcon = (visibility) => {\n    return visibility === 'internal' ? '\ud83d\udd12' : '\ud83d\udc41\ufe0f';\n  };\n\n  const getVisibilityColor = (visibility) => {\n    return visibility === 'internal' ? 'bg-ink/10 text-ink' : 'bg-teal/10 text-teal';\n  };\n\n  return (\n    <div className=\"bg-white rounded-lg shadow-sm p-4 border border-ink/10\">\n      <div className=\"flex items-start justify-between mb-3\">\n        <div className=\"flex items-center space-x-2\">\n          <div className=\"w-8 h-8 rounded-full bg-teal/10 flex items-center justify-center\">\n            <span className=\"text-sm font-body font-medium text-teal\">\n              {comment.user_name?.charAt(0) || '?'}\n            </span>\n          </div>\n          <div>\n            <p className=\"text-sm font-body font-medium text-ink\">{comment.user_name || 'Unknown User'}</p>\n            <p className=\"text-xs font-body text-ink/60\">{formatDate(comment.created_at)}</p>\n          </div>\n        </div>\n        <span className={`inline-flex items-center px-2 py-1 rounded text-xs font-body font-medium ${getVisibilityColor(comment.visibility)}`}>\n          {getVisibilityIcon(comment.visibility)} {comment.visibility === 'internal' ? 'Internal' : 'Visible to Vendor'}\n        </span>\n      </div>\n      <p className=\"font-body text-ink whitespace-pre-wrap\">{comment.comment_text}</p>\n    </div>\n  );\n};\n\nexport default CommentCard;"
  },
  {
    "path": "src/components/BusinessGroupCard.jsx",
    "content": "import React from 'react';\nimport { Link } from 'react-router-dom';\n\nconst BusinessGroupCard = ({ group }) => {\n  return (\n    <Link to={`/business-groups/${group.id}`}>\n      <div className=\"bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition cursor-pointer border border-transparent hover:border-teal\">\n        <div className=\"flex items-start justify-between mb-4\">\n          <div className=\"flex-1\">\n            <h3 className=\"text-xl font-heading font-bold text-ink mb-2\">\n              {group.name}\n            </h3>\n            {group.chamber && (\n              <span className=\"inline-flex items-center px-3 py-1 rounded-full text-xs font-body font-medium bg-teal/10 text-teal mb-2\">\n                {group.chamber}\n              </span>\n            )}\n          </div>\n        </div>\n\n        {group.description && (\n          <p className=\"font-body text-ink/60 text-sm mb-4 line-clamp-2\">\n            {group.description}\n          </p>\n        )}\n\n        {group.lead_user_name && (\n          <div className=\"flex items-center space-x-2 text-sm font-body text-ink/60\">\n            <span>Lead:</span>\n            <span className=\"text-ink font-medium\">{group.lead_user_name}</span>\n          </div>\n        )}\n\n        {group.evaluation_weight_config && (\n          <div className=\"mt-4 pt-4 border-t border-ink/10\">\n            <p className=\"text-xs font-body text-ink/60\">Custom evaluation weights configured</p>\n          </div>\n        )}\n      </div>\n    </Link>\n  );\n};\n\nexport default BusinessGroupCard;"
  },
  {
    "path": "src/components/TrendAnalysisCard.jsx",
    "content": "import React from 'react';\nimport { Link } from 'react-router-dom';\n\nconst TrendAnalysisCard = ({ analysis }) => {\n  const formatDate = (dateString) => {\n    if (!dateString) return 'N/A';\n    return new Date(dateString).toLocaleDateString('en-US', {\n      year: 'numeric',\n      month: 'long',\n      day: 'numeric'\n    });\n  };\n\n  return (\n    <div className=\"bg-white rounded-lg shadow-sm p-6 border border-ink/10\">\n      <div className=\"flex items-start justify-between mb-4\">\n        <div className=\"flex-1\">\n          <h3 className=\"text-xl font-heading font-bold text-ink mb-2\">\n            {analysis.sector ? `${analysis.sector} Sector Trends` : 'Overall Market Trends'}\n          </h3>\n          <p className=\"text-sm font-body text-ink/60\">\n            Analysis Date: {formatDate(analysis.analysis_date)}\n          </p>\n        </div>\n        <span className=\"inline-flex items-center px-3 py-1 rounded-full text-xs font-body font-medium bg-teal/10 text-teal\">\n          {analysis.submission_volume} Proposals\n        </span>\n      </div>\n\n      {analysis.emerging_technologies && analysis.emerging_technologies.length > 0 && (\n        <div className=\"mb-4\">\n          <h4 className=\"text-sm font-body font-medium text-ink mb-2\">Emerging Technologies</h4>\n          <div className=\"flex flex-wrap gap-2\">\n            {analysis.emerging_technologies.map((tech, index) => (\n              <span key={index} className=\"inline-flex items-center px-3 py-1 rounded-full text-xs font-body font-medium bg-gold/10 text-gold\">\n                {tech}\n              </span>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {analysis.average_scores && (\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-3 mt-4 pt-4 border-t border-ink/10\">\n          {Object.entries(analysis.average_scores).map(([key, value]) => (\n            <div key={key}>\n              <p className=\"text-xs font-body text-ink/60 mb-1\">\n                {key.replace(/_/g, ' ').replace(/\\b\\w/g, l => l.toUpperCase())}\n              </p>\n              <p className=\"text-lg font-heading font-bold text-teal\">\n                {typeof value === 'number' ? value.toFixed(1) : value}\n              </p>\n            </div>\n          ))}\n        </div>\n      )}\n\n      <div className=\"mt-4 pt-4 border-t border-ink/10\">\n        <p className=\"text-xs font-body text-ink/40\">\n          Generated by: {analysis.generated_by}\n        </p>\n      </div>\n    </div>\n  );\n};\n\nexport default TrendAnalysisCard;"
  },
  {
    "path": "src/components/AIInteractionCard.jsx",
    "content": "import React from 'react';\n\nconst AIInteractionCard = ({ interaction }) => {\n  const formatDate = (dateString) => {\n    if (!dateString) return 'N/A';\n    return new Date(dateString).toLocaleDateString('en-US', {\n      year: 'numeric',\n      month: 'short',\n      day: 'numeric',\n      hour: '2-digit',\n      minute: '2-digit',\n      second: '2-digit'\n    });\n  };\n\n  const getModelColor = (modelName) => {\n    if (modelName?.includes('claude')) return 'bg-teal/10 text-teal';\n    if (modelName?.includes('gpt') || modelName?.includes('openai')) return 'bg-gold/10 text-gold';\n    if (modelName?.includes('gemini')) return 'bg-burgundy/10 text-burgundy';\n    return 'bg-ink/10 text-ink';\n  };\n\n  return (\n    <div className=\"bg-white rounded-lg shadow-sm p-4 border border-ink/10\">\n      <div className=\"flex items-start justify-between mb-3\">\n        <div className=\"flex-1\">\n          <div className=\"flex items-center space-x-2 mb-2\">\n            <span className={`inline-flex items-center px-3 py-1 rounded-full text-xs font-body font-medium ${getModelColor(interaction.model_name)}`}>\n              {interaction.model_name}\n            </span>\n            <span className=\"inline-flex items-center px-3 py-1 rounded-full text-xs font-body font-medium bg-ink/10 text-ink\">\n              {interaction.operation_type}\n            </span>\n          </div>\n          <p className=\"text-xs font-body text-ink/60\">{formatDate(interaction.timestamp)}</p>\n        </div>\n        <div className=\"text-right\">\n          <p className=\"text-lg font-heading font-bold text-teal\">\n            ${interaction.cost_usd?.toFixed(4) || '0.0000'}\n          </p>\n          <p className=\"text-xs font-body text-ink/60\">{interaction.latency_ms}ms</p>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-3 gap-3 text-sm font-body\">\n        <div>\n          <span className=\"text-ink/60\">Prompt:</span>\n          <p className=\"text-ink font-medium\">{interaction.prompt_tokens} tokens</p>\n        </div>\n        <div>\n          <span className=\"text-ink/60\">Completion:</span>\n          <p className=\"text-ink font-medium\">{interaction.completion_tokens} tokens</p>\n        </div>\n        <div>\n          <span className=\"text-ink/60\">\u03a3I Units:</span>\n          <p className=\"text-ink font-medium\">{interaction.intelligence_units?.toFixed(2) || '0.00'}</p>\n        </div>\n      </div>\n\n      {(interaction.energy_kwh || interaction.carbon_gco2) && (\n        <div className=\"mt-3 pt-3 border-t border-ink/10 flex items-center space-x-4 text-xs font-body text-ink/60\">\n          {interaction.energy_kwh && (\n            <div>\n              <span>Energy:</span>\n              <span className=\"ml-1 font-medium\">{interaction.energy_kwh.toFixed(6)} kWh</span>\n            </div>\n          )}\n          {interaction.carbon_gco2 && (\n            <div>\n              <span>Carbon:</span>\n              <span className=\"ml-1 font-medium\">{interaction.carbon_gco2.toFixed(4)} gCO\u2082</span>\n            </div>\n          )}\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default AIInteractionCard;"
  },
  {
    "path": "src/components/Pagination.jsx",
    "content": "import React from 'react';\n\nconst Pagination = ({ currentPage, totalPages, onPageChange }) => {\n  const pages = [];\n  const maxPagesToShow = 5;\n  \n  let startPage = Math.max(1, currentPage - Math.floor(maxPagesToShow / 2));\n  let endPage = Math.min(totalPages, startPage + maxPagesToShow - 1);\n  \n  if (endPage - startPage < maxPagesToShow - 1) {\n    startPage = Math.max(1, endPage - maxPagesToShow + 1);\n  }\n\n  for (let i = startPage; i <= endPage; i++) {\n    pages.push(i);\n  }\n\n  return (\n    <div className=\"flex items-center justify-center space-x-2\">\n      <button\n        onClick={() => onPageChange(currentPage - 1)}\n        disabled={currentPage === 1}\n        className=\"px-3 py-2 rounded-lg font-body text-sm font-medium text-ink border border-ink/20 hover:bg-teal hover:text-white hover:border-teal transition disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-transparent disabled:hover:text-ink\"\n      >\n        Previous\n      </button>\n\n      {startPage > 1 && (\n        <>\n          <button\n            onClick={() => onPageChange(1)}\n            className=\"px-3 py-2 rounded-lg font-body text-sm font-medium text-ink border border-ink/20 hover:bg-teal hover:text-white hover:border-teal transition\"\n          >\n            1\n          </button>\n          {startPage > 2 && (\n            <span className=\"px-2 text-ink/40\">...</span>\n          )}\n        </>\n      )}\n\n      {pages.map((page) => (\n        <button\n          key={page}\n          onClick={() => onPageChange(page)}\n          className={`px-3 py-2 rounded-lg font-body text-sm font-medium border transition ${\n            page === currentPage\n              ? 'bg-teal text-white border-teal'\n              : 'text-ink border-ink/20 hover:bg-teal hover:text-white hover:border-teal'\n          }`}\n        >\n          {page}\n        </button>\n      ))}\n\n      {endPage < totalPages && (\n        <>\n          {endPage < totalPages - 1 && (\n            <span className=\"px-2 text-ink/40\">...</span>\n          )}\n          <button\n            onClick={() => onPageChange(totalPages)}\n            className=\"px-3 py-2 rounded-lg font-body text-sm font-medium text-ink border border-ink/20 hover:bg-teal hover:text-white hover:border-teal transition\"\n          >\n            {totalPages}\n          </button>\n        </>\n      )}\n\n      <button\n        onClick={() => onPageChange(currentPage + 1)}\n        disabled={currentPage === totalPages}\n        className=\"px-3 py-2 rounded-lg font-body text-sm font-medium text-ink border border-ink/20 hover:bg-teal hover:text-white hover:border-teal transition disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-transparent disabled:hover:text-ink\"\n      >\n        Next\n      </button>\n    </div>\n  );\n};\n\nexport default Pagination;"
  },
  {
    "path": "src/components/LoadingSpinner.jsx",
    "content": "import React from 'react';\n\nconst LoadingSpinner = ({ size = 'md', text = null }) => {\n  const sizeClasses = {\n    sm: 'h-6 w-6',\n    md: 'h-12 w-12',\n    lg: 'h-16 w-16'\n  };\n\n  return (\n    <div className=\"flex flex-col items-center justify-center\">\n      <div className={`animate-spin rounded-full border-b-2 border-teal ${sizeClasses[size]}`}></div>\n      {text && (\n        <p className=\"mt-4 font-body text-ink/60 text-sm\">{text}</p>\n      )}\n    </div>\n  );\n};\n\nexport default LoadingSpinner;"
  },
  {
    "path": "src/components/EmptyState.jsx",
    "content": "import React from 'react';\nimport { Link } from 'react-router-dom';\n\nconst EmptyState = ({ title, description, actionText, actionLink }) => {\n  return (\n    <div className=\"text-center py-12\">\n      <div className=\"inline-flex items-center justify-center w-16 h-16 rounded-full bg-teal/10 mb-4\">\n        <svg className=\"w-8 h-8 text-teal\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n          <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\" />\n        </svg>\n      </div>\n      <h3 className=\"text-xl font-heading font-bold text-ink mb-2\">{title}</h3>\n      <p className=\"text-ink/60 font-body mb-6 max-w-md mx-auto\">{description}</p>\n      {actionText && actionLink && (\n        <Link\n          to={actionLink}\n          className=\"inline-flex items-center px-6 py-3 bg-teal text-white rounded-lg font-body font-medium hover:bg-teal/90 transition\"\n        >\n          {actionText}\n        </Link>\n      )}\n    </div>\n  );\n};\n\nexport default EmptyState;"
  },
  {
    "path": "src/components/ErrorBanner.jsx",
    "content": "import React from 'react';\n\nconst ErrorBanner = ({ message, onDismiss }) => {\n  if (!message) return null;\n\n  return (\n    <div className=\"mb-6 p-4 bg-burgundy/10 border border-burgundy rounded-lg flex items-start justify-between\">\n      <div className=\"flex items-start space-x-3\">\n        <svg className=\"w-5 h-5 text-burgundy mt-0.5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n          <path fillRule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z\" clipRule=\"evenodd\" />\n        </svg>\n        <p className=\"text-burgundy font-body\">{message}</p>\n      </div>\n      {onDismiss && (\n        <button\n          onClick={onDismiss}\n          className=\"text-burgundy hover:text-burgundy/80 transition\"\n        >\n          <svg className=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n            <path fillRule=\"evenodd\" d=\"M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z\" clipRule=\"evenodd\" />\n          </svg>\n        </button>\n      )}\n    </div>\n  );\n};\n\nexport default ErrorBanner;"
  },
  {
    "path": "src/components/SuccessBanner.jsx",
    "content": "import React from 'react';\n\nconst SuccessBanner = ({ message, onDismiss }) => {\n  if (!message) return null;\n\n  return (\n    <div className=\"mb-6 p-4 bg-teal/10 border border-teal rounded-lg flex items-start justify-between\">\n      <div className=\"flex items-start space-x-3\">\n        <svg className=\"w-5 h-5 text-teal mt-0.5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n          <path fillRule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clipRule=\"evenodd\" />\n        </svg>\n        <p className=\"text-teal font-body\">{message}</p>\n      </div>\n      {onDismiss && (\n        <button\n          onClick={onDismiss}\n          className=\"text-teal hover:text-teal/80 transition\"\n        >\n          <svg className=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n            <path fillRule=\"evenodd\" d=\"M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z\" clipRule=\"evenodd\" />\n          </svg>\n        </button>\n      )}\n    </div>\n  );\n};\n\nexport default SuccessBanner;"
  },
  {
    "path": "src/pages/AnalyticsDashboard.jsx",
    "content": "import React, { useState, useEffect } from 'react';\nimport { Link } from 'react-router-dom';\nimport axios from 'axios';\nimport { getErrorMessage } from '../lib/api';\nimport LoadingSpinner from '../components/LoadingSpinner';\nimport ErrorBanner from '../components/ErrorBanner';\nimport ScoreBadge from '../components/ScoreBadge';\nimport TrendAnalysisCard from '../components/TrendAnalysisCard';\n\nconst AnalyticsDashboard = () => {\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState(null);\n  const [user, setUser] = useState(null);\n  const [dashboardData, setDashboardData] = useState(null);\n  const [trendAnalyses, setTrendAnalyses] = useState([]);\n  const [aiMetrics, setAiMetrics] = useState(null);\n  const [selectedSector, setSelectedSector] = useState('all');\n  const [timeRange, setTimeRange] = useState('30d');\n\n  useEffect(() => {\n    fetchData();\n  }, [selectedSector, timeRange]);\n\n  const fetchData = async () => {\n    setLoading(true);\n    setError(null);\n    try {\n      const userResponse = await axios.get('/api/v1/users/me');\n      setUser(userResponse.data);\n\n      // Fetch appropriate dashboard based on role\n      let dashboardEndpoint = '/api/v1/dashboard/analyst';\n      if (userResponse.data.role === 'executive') {\n        dashboardEndpoint = '/api/v1/dashboard/executive';\n      } else if (selectedSector !== 'all') {\n        dashboardEndpoint = `/api/v1/dashboard/sector/${selectedSector}`;\n      }\n\n      const [dashboardResponse, trendsResponse, aiResponse] = await Promise.all([\n        axios.get(dashboardEndpoint),\n        axios.get('/api/v1/trend-analyses', { params: { limit: 5 } }),\n        axios.get('/api/v1/ai-interactions')\n      ]);\n\n      setDashboardData(dashboardResponse.data);\n      setTrendAnalyses(trendsResponse.data.trend_analyses || []);\n      setAiMetrics(aiResponse.data);\n    } catch (err) {\n      setError(getErrorMessage(err));\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleGenerateTrends = async () => {\n    setLoading(true);\n    setError(null);\n    try {\n      await axios.post('/api/v1/trend-analyses/generate');\n      await fetchData();\n    } catch (err) {\n      setError(getErrorMessage(err));\n      setLoading(false);\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-cream flex items-center justify-center\">\n        <LoadingSpinner size=\"lg\" text=\"Loading analytics...\" />\n      </div>\n    );\n  }\n\n  const sectors = ['all', 'fintech', 'healthcare', 'logistics', 'energy', 'education', 'government', 'tourism'];\n\n  return (\n    <div className=\"min-h-screen bg-cream py-8\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between mb-8\">\n          <div>\n            <h1 className=\"text-4xl font-heading font-bold text-ink mb-2\">Analytics Dashboard</h1>\n            <p className=\"text-ink/60 font-body\">AI-powered insights and trend analysis</p>\n          </div>\n          {user?.role === 'executive' && (\n            <button\n              onClick={handleGenerateTrends}\n              className=\"px-6 py-3 bg-teal text-white rounded-lg font-body font-medium hover:bg-teal/90 transition\"\n            >\n              Generate New Analysis\n            </button>\n          )}\n        </div>\n\n        <ErrorBanner message={error} onDismiss={() => setError(null)} />\n\n        {/* Filters */}\n        <div className=\"bg-white rounded-xl shadow-sm p-6 mb-8\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-sm font-body font-medium text-ink mb-2\">Sector</label>\n              <select\n                value={selectedSector}\n                onChange={(e) => setSelectedSector(e.target.value)}\n                className=\"w-full px-4 py-2 border border-ink/20 rounded-lg font-body text-ink focus:outline-none focus:ring-2 focus:ring-teal\"\n              >\n                {sectors.map((sector) => (\n                  <option key={sector} value={sector}"
  },
  {
    "path": "package.json",
