  "ai_team.philosophy_title": "\u0641\u0644\u0633\u0641\u0629 \u0627\u0644\u0641\u0631\u064A\u0642",
  "ai_team.philosophy_body": "\u0643\u0644 \u0645\u062A\u062E\u0635\u0635 \u0641\u064A \u03c3I \u064A\u0639\u0645\u0644 \u0628\u0646\u0641\u0633 \u0627\u0644\u0645\u0628\u062F\u0623: \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064A \u064A\u0648\u0635\u064A\u060C \u0648\u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u064A\u0642\u0631\u0631. \u0644\u0627 \u0625\u062C\u0631\u0627\u0621\u0627\u062A \u0645\u0633\u062A\u0642\u0644\u0629. \u0634\u0641\u0627\u0641\u064A\u0629 \u0643\u0627\u0645\u0644\u0629. \u0633\u062C\u0644 \u062A\u062F\u0642\u064A\u0642 \u0643\u0627\u0645\u0644. \u0630\u0643\u0627\u0621 \u0645\u0636\u0627\u0641 \u2014 \u0644\u064A\u0633 \u0630\u0643\u0627\u0621 \u0627\u0635\u0637\u0646\u0627\u0639\u064A.",
