  "ai_team.title": "\u062A\u0639\u0631\u0641 \u0639\u0644\u0649 \u0641\u0631\u064A\u0642 \u03c3I",
  "ai_team.subtitle": "\u0645\u062A\u062E\u0635\u0635\u0648 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064A \u0648\u0631\u0627\u0621 \u0643\u0644 \u0642\u0631\u0627\u0631. \u0643\u0644 \u0645\u0646\u0647\u0645 \u064A\u0639\u0645\u0644 \u062A\u062D\u062A \u0625\u0634\u0631\u0627\u0641 \u0628\u0634\u0631\u064A. \u0644\u0627 \u0623\u062D\u062F \u064A\u0639\u0645\u0644 \u0628\u0645\u0641\u0631\u062F\u0647.",
